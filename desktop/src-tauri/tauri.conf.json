{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iac-code",
  "version": "0.13.1",
  "identifier": "com.alibaba.cloud.iaccode.desktop",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["desktop-local", "desktop-loopback-external"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}
