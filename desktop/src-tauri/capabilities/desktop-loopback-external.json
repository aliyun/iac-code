{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-loopback-external",
  "description": "Non-updater commands available to the healthy Desktop loopback Web app.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "allow-select-project-directory",
    "allow-confirm-secret-reveal",
    "allow-restart-sidecar",
    "allow-open-diagnostics-directory",
    "allow-open-external-url"
  ]
}
