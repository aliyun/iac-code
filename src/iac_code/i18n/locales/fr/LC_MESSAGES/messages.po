msgstr "Le contexte {} contient Ref {}, qui n'est pas un Parameter visible."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This context uses ParamRef; normal Resource/DataSource values are not "
"allowed, and List/Map cannot be used as parameter keys."
msgstr ""
"Ce contexte utilise ParamRef; les valeurs normales Resource/DataSource ne"
" sont pas autorisées, et List/Map ne peut pas être utilisé comme touches "
"de paramètre."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
