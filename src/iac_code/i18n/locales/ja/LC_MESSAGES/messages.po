msgstr "Alibaba Cloud API {operation} のバイナリリクエストボディには body_file が必要です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} requires parameter {parameter}."
msgstr "Alibaba Cloud API {operation} にはパラメーター {parameter} が必要です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} requires parameters {parameters}."
msgstr "Alibaba Cloud API {operation} にはパラメーター {parameters} が必要です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing required parameters."
msgstr "Alibaba Cloud API {operation} に必須パラメーターがありません。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "the requested parameter"
msgstr "要求されたパラメーター"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects {expected} "
