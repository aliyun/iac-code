msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} ist kein "
"zulässiger Wert."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameter {parameter}."
msgstr "Der Alibaba-Cloud-API {operation} fehlt der Pfadparameter {parameter}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameters {parameters}."
msgstr "Der Alibaba-Cloud-API {operation} fehlen die Pfadparameter {parameters}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API path parameters are invalid or incomplete for "
"{operation}."
msgstr ""
"Die Pfadparameter der Alibaba-Cloud-API für {operation} sind ungültig "
"oder unvollständig."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} path parameter {parameter} expects "
"{expected} but received {actual}."
msgstr ""
"Der Pfadparameter {parameter} der Alibaba-Cloud-API {operation} erwartet "
"{expected}, hat aber {actual} erhalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a scalar "
"header value without line breaks but received {actual}."
msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} erwartet "
"einen skalaren Headerwert ohne Zeilenumbrüche, hat aber {actual} "
"erhalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid "
"header name but received a {actual} with invalid syntax."
msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} erwartet "
"einen gültigen Headernamen, hat aber {actual} mit ungültiger Syntax "
"erhalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid DNS "
"host-label string but received {actual} with invalid syntax."
msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} erwartet eine"
" gültige DNS-Hostlabel-Zeichenfolge, hat aber {actual} mit ungültiger "
"Syntax erhalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} targets a reserved "
"authentication header. Remove the parameter and retry."
msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} zielt auf "
"einen reservierten Authentifizierungsheader. Entfernen Sie den Parameter "
"und versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} uses a protocol shape this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"Die Alibaba-Cloud-API {operation} verwendet eine Protokollform, die diese"
" Laufzeit nicht ausführen kann. Wählen Sie eine andere API-Version oder "
"Aktion."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} metadata uses a schema this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"Die Metadaten der Alibaba-Cloud-API {operation} verwenden ein Schema, das"
" diese Laufzeit nicht ausführen kann. Wählen Sie eine andere API-Version "
"oder Aktion."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud OSS API {operation} is not supported by this runtime. "
"Choose a supported OSS action or use another client."
msgstr ""
"Die Alibaba-Cloud-OSS-API {operation} wird von dieser Laufzeit nicht "
"unterstützt. Wählen Sie eine unterstützte OSS-Aktion oder verwenden Sie "
"einen anderen Client."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} cannot be executed from its current "
"metadata. Choose another API version or action."
msgstr ""
"Die Alibaba-Cloud-API {operation} kann mit ihren aktuellen Metadaten "
"nicht ausgeführt werden. Wählen Sie eine andere API-Version oder Aktion."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud endpoint cache could not be updated for {operation} in "
"{region}. Check local configuration storage and retry."
msgstr ""
"Der Alibaba-Cloud-Endpunkt-Cache für {operation} in {region} konnte nicht"
" aktualisiert werden. Prüfen Sie den lokalen Konfigurationsspeicher und "
"versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata service is unreachable, so "
"{operation} cannot be signed. Confirm this process runs on an ECS "
"instance with a bound RAM role."
msgstr ""
"Der Metadatendienst der Alibaba-Cloud-ECS-Instanz ist nicht erreichbar, "
"daher kann {operation} nicht signiert werden. Stellen Sie sicher, dass "
"dieser Prozess auf einer ECS-Instanz mit zugewiesener RAM-Rolle läuft."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata credentials are disabled, so "
"{operation} cannot be signed. Check the "
"ALIBABA_CLOUD_ECS_METADATA_DISABLED environment variable."
msgstr ""
"Die Anmeldeinformationen aus den Metadaten der Alibaba-Cloud-ECS-Instanz "
"sind deaktiviert, daher kann {operation} nicht signiert werden. Prüfen "
"Sie die Umgebungsvariable ALIBABA_CLOUD_ECS_METADATA_DISABLED."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS metadata token (IMDSv2) could not be obtained while "
"IMDSv1 is disabled, so {operation} cannot be signed. Check the instance "
"metadata settings and network."
msgstr ""
"Das Alibaba-Cloud-ECS-Metadaten-Token (IMDSv2) konnte nicht abgerufen "
"werden, während IMDSv1 deaktiviert ist, daher kann {operation} nicht "
"signiert werden. Prüfen Sie die Metadateneinstellungen der Instanz und "
"das Netzwerk."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No matching Alibaba Cloud ECS instance RAM role was found, so {operation}"
" cannot be signed. Check the instance RAM role and the configured ECS RAM"
" role name."
msgstr ""
"Es wurde keine passende RAM-Rolle der Alibaba-Cloud-ECS-Instanz gefunden,"
" daher kann {operation} nicht signiert werden. Prüfen Sie die RAM-Rolle "
"der Instanz und den konfigurierten Namen der ECS-RAM-Rolle."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata returned incomplete RAM role "
"credentials, so {operation} cannot be signed. Retry and check the ECS "
"metadata service."
msgstr ""
"Die Metadaten der Alibaba-Cloud-ECS-Instanz haben unvollständige RAM-"
"Rollen-Anmeldeinformationen zurückgegeben, daher kann {operation} nicht "
"signiert werden. Versuchen Sie es erneut und prüfen Sie den ECS-"
"Metadatendienst."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance RAM role credentials could not be refreshed "
"before they expired, so {operation} cannot be signed. Check ECS metadata "
"availability."
msgstr ""
"Die Anmeldeinformationen der RAM-Rolle der Alibaba-Cloud-ECS-Instanz "
"konnten vor ihrem Ablauf nicht erneuert werden, daher kann {operation} "
"nicht signiert werden. Prüfen Sie die Verfügbarkeit der ECS-Metadaten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No trusted Alibaba Cloud endpoint is available for {operation} in "
"{region}. Check the region or endpoint configuration."
msgstr ""
"Für {operation} in {region} ist kein vertrauenswürdiger Alibaba-Cloud-"
"Endpunkt verfügbar. Prüfen Sie die Region oder Endpunktkonfiguration."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud host parameters are invalid for {operation} in {region}."
msgstr "Die Alibaba-Cloud-Hostparameter für {operation} in {region} sind ungültig."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud authentication is unsupported for {operation}. Check the "
"API contract or choose an API that supports AccessKey authentication."
msgstr ""
"Die Alibaba-Cloud-Authentifizierung wird für {operation} nicht "
"unterstützt. Prüfen Sie den API-Vertrag oder wählen Sie eine API mit "
"AccessKey-Authentifizierung."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud credentials are unavailable. Configure credentials and "
"retry {operation}."
msgstr ""
"Alibaba-Cloud-Anmeldedaten sind nicht verfügbar. Konfigurieren Sie "
"Anmeldedaten und versuchen Sie {operation} erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} is reserved for "
"request signing and cannot be set."
msgstr ""
"Der Parameter {parameter} der Alibaba-Cloud-API {operation} ist für die "
"Anfragesignatur reserviert und kann nicht gesetzt werden."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud signing is unsupported for {operation}. Check the API "
"contract."
msgstr ""
"Die Alibaba-Cloud-Signatur wird für {operation} nicht unterstützt. Prüfen"
" Sie den API-Vertrag."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API execution is unavailable for {operation}. Retry from an"
" active runtime."
msgstr ""
"Die Ausführung der Alibaba-Cloud-API ist für {operation} nicht verfügbar."
" Versuchen Sie es in einer aktiven Laufzeit erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} cannot modify cloud resources from a "
"pipeline step. Use a pipeline-specific tool for this operation."
msgstr ""
"Die Alibaba-Cloud-API {operation} darf in einem Pipeline-Schritt keine "
"Cloud-Ressourcen ändern. Verwenden Sie für diesen Vorgang ein Pipeline-"
"spezifisches Tool."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API authorization expired or changed. Run {operation} again"
" to approve the current contract."
msgstr ""
"Die Autorisierung der Alibaba-Cloud-API ist abgelaufen oder wurde "
"geändert. Führen Sie {operation} erneut aus, um den aktuellen Vertrag zu "
"genehmigen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} does not accept body_file. Use the body "
"source declared by the API contract."
msgstr ""
"Die Alibaba-Cloud-API {operation} akzeptiert body_file nicht. Verwenden "
"Sie die im API-Vertrag deklarierte Quelle für den Anfragetext."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body_file exceeds the 32 MiB limit. Use a "
"smaller regular file."
msgstr ""
"body_file der Alibaba-Cloud-API {operation} überschreitet die Grenze von "
"32 MiB. Verwenden Sie eine kleinere reguläre Datei."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} requires a body source compatible with its "
"API contract."
msgstr ""
"Die Alibaba-Cloud-API {operation} benötigt eine mit ihrem API-Vertrag "
"kompatible Quelle für den Anfragetext."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received multiple body sources. Provide "
"only one of body, body_file, or body parameters."
msgstr ""
"Die Alibaba-Cloud-API {operation} hat mehrere Quellen für den Anfragetext"
" erhalten. Geben Sie nur body, body_file oder body-Parameter an."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received multiple template sources. Provide"
" only one."
msgstr ""
"Die Alibaba-Cloud-API {operation} hat mehrere Vorlagenquellen erhalten. "
"Geben Sie nur eine an."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} content_type does not match the request "
"body. Use a compatible media type."
msgstr ""
"content_type der Alibaba-Cloud-API {operation} stimmt nicht mit dem "
"Anfragetext überein. Verwenden Sie einen kompatiblen Medientyp."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} has content_type without a request body. "
"Remove content_type or provide a body."
msgstr ""
"Die Alibaba-Cloud-API {operation} enthält content_type ohne Anfragetext. "
"Entfernen Sie content_type oder geben Sie einen Anfragetext an."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body is invalid. Provide a valid JSON or "
"form request body."
msgstr ""
"Der Anfragetext der Alibaba-Cloud-API {operation} ist ungültig. Geben Sie"
" einen gültigen JSON- oder Formular-Anfragetext an."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body_file is invalid. Use a readable "
"regular file within the allowed size."
msgstr ""
"body_file der Alibaba-Cloud-API {operation} ist ungültig. Verwenden Sie "
"eine lesbare reguläre Datei innerhalb der zulässigen Größe."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} content_type is invalid. Use a valid media "
"type such as application/json."
msgstr ""
"content_type der Alibaba-Cloud-API {operation} ist ungültig. Verwenden "
"Sie einen gültigen Medientyp wie application/json."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} template file is invalid. Use a readable "
"regular template file."
msgstr ""
"Die Vorlagendatei der Alibaba-Cloud-API {operation} ist ungültig. "
"Verwenden Sie eine lesbare reguläre Vorlagendatei."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} template validation failed. Check the "
"template syntax and resource definitions."
msgstr ""
"Die Vorlagenvalidierung der Alibaba-Cloud-API {operation} ist "
"fehlgeschlagen. Prüfen Sie Vorlagensyntax und Ressourcendefinitionen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} max_response_bytes must be between 1 and "
"16777216."
msgstr ""
"max_response_bytes der Alibaba-Cloud-API {operation} muss zwischen 1 und "
"16777216 liegen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned HTTP {status} with error code "
"{code}. Check the request and cloud permissions before retrying."
msgstr ""
"Die Alibaba-Cloud-API {operation} gab HTTP {status} mit Fehlercode {code}"
" zurück. Prüfen Sie Anfrage und Cloud-Berechtigungen vor einem erneuten "
"Versuch."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned HTTP {status}. Check the request "
"and cloud permissions before retrying."
msgstr ""
"Die Alibaba-Cloud-API {operation} gab HTTP {status} zurück. Prüfen Sie "
"Anfrage und Cloud-Berechtigungen vor einem erneuten Versuch."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} could not connect before the request was "
"sent. Check network and endpoint access, then retry."
msgstr ""
"Die Alibaba-Cloud-API {operation} konnte vor dem Senden der Anfrage keine"
" Verbindung herstellen. Prüfen Sie Netzwerk- und Endpunktzugriff und "
"versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received a retryable service response, but "
"the retry deadline expired. Retry the read-only request later."
msgstr ""
"Die Alibaba-Cloud-API {operation} erhielt eine wiederholbare "
"Dienstantwort, aber die Wiederholungsfrist ist abgelaufen. Wiederholen "
"Sie die schreibgeschützte Anfrage später."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} read-only request did not complete before "
"the retry deadline. Check network and service health, then retry."
msgstr ""
"Die schreibgeschützte Anfrage der Alibaba-Cloud-API {operation} wurde "
"nicht vor Ablauf der Wiederholungsfrist abgeschlossen. Prüfen Sie "
"Netzwerk- und Dienstzustand und versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} timed out after the request may have been "
"sent. Check cloud state before retrying to avoid duplicate changes."
msgstr ""
"Bei der Alibaba-Cloud-API {operation} trat möglicherweise nach dem Senden"
" der Anfrage eine Zeitüberschreitung auf. Prüfen Sie vor einem erneuten "
"Versuch den Cloud-Zustand, um doppelte Änderungen zu vermeiden."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} timed out before the request was sent. "
"Retry the operation."
msgstr ""
"Bei der Alibaba-Cloud-API {operation} trat vor dem Senden der Anfrage "
"eine Zeitüberschreitung auf. Wiederholen Sie den Vorgang."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned an invalid response after the "
"request was sent. Check cloud state before retrying to avoid duplicate "
"changes."
msgstr ""
"Die Alibaba-Cloud-API {operation} gab nach dem Senden der Anfrage eine "
"ungültige Antwort zurück. Prüfen Sie vor einem erneuten Versuch den "
"Cloud-Zustand, um doppelte Änderungen zu vermeiden."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} may have been sent before the connection "
"failed. Check cloud state before retrying to avoid duplicate changes."
msgstr ""
"Die Anfrage der Alibaba-Cloud-API {operation} wurde möglicherweise vor "
"dem Verbindungsfehler gesendet. Prüfen Sie vor einem erneuten Versuch den"
" Cloud-Zustand, um doppelte Änderungen zu vermeiden."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} response exceeded max_response_bytes. "
"Increase the limit or narrow the request and retry."
msgstr ""
"Die Antwort der Alibaba-Cloud-API {operation} überschritt "
"max_response_bytes. Erhöhen Sie die Grenze oder schränken Sie die Anfrage"
" ein und versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} error response exceeded the 1 MiB safety "
"limit. Check Alibaba Cloud logs before retrying."
msgstr ""
"Die Fehlerantwort der Alibaba-Cloud-API {operation} überschritt die "
"Sicherheitsgrenze von 1 MiB. Prüfen Sie vor einem erneuten Versuch die "
"Alibaba-Cloud-Protokolle."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API parameters are invalid for {operation}."
msgstr "Die Alibaba-Cloud-API-Parameter für {operation} sind ungültig."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} could not be prepared safely. Check the "
"request and try again."
msgstr ""
"Die Alibaba-Cloud-API {operation} konnte nicht sicher vorbereitet werden."
" Prüfen Sie die Anfrage und versuchen Sie es erneut."

