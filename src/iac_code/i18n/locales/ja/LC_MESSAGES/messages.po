#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud product must contain only letters, numbers, underscores, or"
" hyphens."
msgstr "Alibaba Cloud のプロダクトには、英字、数字、アンダースコア、ハイフンのみ使用できます。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud API action must contain only letters, numbers, underscores,"
" or hyphens."
msgstr "Alibaba Cloud API のアクションには、英字、数字、アンダースコア、ハイフンのみ使用できます。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "Alibaba Cloud API version contains unsupported characters."
msgstr "Alibaba Cloud API のバージョンにサポートされていない文字が含まれています。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud region must contain only lowercase letters, numbers, or "
"hyphens."
msgstr "Alibaba Cloud のリージョンには、小文字、数字、ハイフンのみ使用できます。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API protocol overrides are invalid for {operation}. Remove "
"style, method, or pathname overrides and retry."
msgstr ""
"{operation} の Alibaba Cloud API プロトコル上書きが無効です。style、method、pathname "
"の上書きを削除して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API input is invalid for {operation}. Check product, "
"action, version, region, and parameters."
msgstr ""
"{operation} の Alibaba Cloud API "
"入力が無効です。プロダクト、アクション、バージョン、リージョン、パラメーターを確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud returned the target response, but its headers are too large"
" to display safely. Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud "
"は対象のレスポンスを返しましたが、ヘッダーが大きすぎるため安全に表示できません。再試行する前にクラウドリソースの状態を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud returned an unsupported response body for {operation}. "
"Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud は {operation} "
"に対してサポートされていないレスポンス本文を返しました。再試行する前にクラウドリソースの状態を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} detail must be one of: summary, full."
msgstr "Alibaba Cloud API {operation} の detail は summary または full のいずれかである必要があります。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud product {product} was not found. Check the product code and"
" try again."
msgstr "Alibaba Cloud プロダクト {product} が見つかりません。プロダクトコードを確認して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid " Suggested product codes: {suggestions}."
msgstr " 推奨されるプロダクトコード: {suggestions}。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {product}/{version}/{action} was not found. Check the "
"product, version, and action."
msgstr ""
"Alibaba Cloud API {product}/{version}/{action} "
"が見つかりません。プロダクト、バージョン、アクションを確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} was not found. Check the product, version, "
"and action."
msgstr "Alibaba Cloud API {operation} が見つかりません。プロダクト、バージョン、アクションを確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API metadata for {operation} is temporarily unavailable; "
"try again later."
msgstr "{operation} の Alibaba Cloud API メタデータは一時的に利用できません。後でもう一度お試しください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API metadata for {operation} returned an incompatible "
"response. Check the API identifiers or try again later."
msgstr ""
"{operation} の Alibaba Cloud API メタデータから互換性のないレスポンスが返されました。API "
"識別子を確認するか、後でもう一度お試しください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No valid Alibaba Cloud API version is available for {product}; provide an"
" explicit version."
msgstr "{product} に有効な Alibaba Cloud API バージョンがありません。明示的にバージョンを指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} requires body_file for its binary request "
