msgstr ""
"Ce pseudo paramètre n'est visible que dans le contenu réinscriptible "
"d'une instance de ressource Count."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} contains Ref {}, which cannot reference a Local."
msgstr "{} contient Ref {}, qui ne peut faire référence à un Local."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"ROS Local precompilation replaces only resource Count and Properties; "
