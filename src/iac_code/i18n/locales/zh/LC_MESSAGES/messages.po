"Alibaba Cloud API {operation} timed out after the request may have been "
"sent. Check cloud state before retrying to avoid duplicate changes."
msgstr "阿里云 API {operation} 在请求可能已发送后超时。为避免重复变更，请在重试前检查云端状态。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} timed out before the request was sent. "
"Retry the operation."
msgstr "阿里云 API {operation} 在发送请求前超时。请重试该操作。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned an invalid response after the "
"request was sent. Check cloud state before retrying to avoid duplicate "
"changes."
msgstr "阿里云 API {operation} 在请求发送后返回了无效响应。为避免重复变更，请在重试前检查云端状态。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} may have been sent before the connection "
"failed. Check cloud state before retrying to avoid duplicate changes."
msgstr "阿里云 API {operation} 可能已在连接失败前发送。为避免重复变更，请在重试前检查云端状态。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} response exceeded max_response_bytes. "
"Increase the limit or narrow the request and retry."
msgstr "阿里云 API {operation} 的响应超过 max_response_bytes。请提高限制或缩小请求范围后重试。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
