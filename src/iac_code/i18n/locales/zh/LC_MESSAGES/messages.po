#: src/iac_code/pipeline/engine/show_diagram_tool.py
msgid ""
"Read a ROS template YAML file and generate an architecture diagram. Pass "
"the template file path relative to the working directory and the "
"candidate name."
msgstr "读取 ROS 模板 YAML 文件并生成架构图。请传入相对于工作目录的模板文件路径和候选方案名称。"

#: src/iac_code/pipeline/engine/show_diagram_tool.py
msgid ""
"Relative path to the ROS template YAML file, such as templates/1-simple-"
"nginx.yml"
msgstr "ROS 模板 YAML 文件的相对路径，例如 templates/1-simple-nginx.yml"

#: src/iac_code/pipeline/engine/show_diagram_tool.py
