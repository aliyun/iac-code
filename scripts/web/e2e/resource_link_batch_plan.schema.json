{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iac-code.local/schemas/resource-link-batch-plan-v1.json",
  "title": "Resource-link five-type browser batch plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "catalogRevisionDigest", "planId", "site", "source", "batchSize",
    "resume", "skippedBlocked", "skippedPending", "skippedUnreplayable", "items"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "catalogRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "site": {"const": "aliyun"},
    "source": {"enum": ["route_catalog", "query_api", "create_api"]},
    "batchSize": {"type": "integer", "minimum": 0, "maximum": 5},
    "resume": {"type": "boolean"},
    "skippedBlocked": {"type": "integer", "minimum": 0},
    "skippedPending": {"type": "integer", "minimum": 0},
    "skippedUnreplayable": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceType", "canonicalResourceType", "receiptSource", "contractId", "product", "action", "sourceChainStatus",
          "sourceEvidenceDigest", "sampleLevel", "actualApiCalled", "missingNavigations",
          "allowedNavigations", "resumeContext", "excludedSampleContexts"
        ],
        "properties": {
          "sourceType": {"type": "string", "minLength": 1},
          "canonicalResourceType": {"type": "string", "minLength": 1},
          "receiptSource": {"enum": ["route_catalog", "ros_stack", "query_api", "create_api"]},
          "contractId": {"type": "string", "minLength": 1},
          "product": {"type": ["string", "null"]},
          "action": {"type": ["string", "null"]},
          "sourceChainStatus": {"const": "passed"},
          "sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sampleLevel": {"enum": ["L1", "L2", "L3"]},
          "actualApiCalled": {"type": "boolean"},
          "querySourceBinding": {"type": "object", "additionalProperties": false,
            "required": ["resourceIdentifierDigest", "regionId"],
            "properties": {
              "resourceIdentifierDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "regionId": {"type": ["string", "null"]},
              "sessionIdDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "accountScopeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source": {"type": "object", "additionalProperties": {"type": "string"}}
            }
          },
          "routeSourceBinding": {
            "type": "object", "additionalProperties": false,
            "required": ["regionId", "resourceIdentifierDigests"],
            "properties": {
              "regionId": {"type": "string", "minLength": 1},
              "resourceIdentifierDigests": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "parentAttributes": {
                "type": "object", "minProperties": 1,
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          },
          "missingNavigations": {
            "type": "array",
            "items": {"enum": ["normal", "shift"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "allowedNavigations": {
            "type": "array",
            "items": {"enum": ["normal", "shift"]},
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "contains": {"const": "normal"}
          },
          "resumeContext": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "resourceIdentifierDigest", "sessionIdDigest", "accountScopeDigest", "regionId",
              "sourceEvidenceDigest", "artifactPaths", "nextAttemptCounts"
            ],
            "properties": {
              "resourceIdentifierDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "sessionIdDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "accountScopeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "regionId": {"type": ["string", "null"]},
              "sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "artifactPaths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "nextAttemptCounts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "normal": {"type": "integer", "minimum": 1, "maximum": 2},
                  "shift": {"type": "integer", "minimum": 1, "maximum": 2}
                }
              }
            }
          },
          "excludedSampleContexts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resourceIdentifierDigest", "sessionIdDigest", "accountScopeDigest", "regionId",
                "sourceEvidenceDigest"
              ],
              "properties": {
                "resourceIdentifierDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "sessionIdDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "accountScopeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "regionId": {"type": ["string", "null"]},
                "sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
