msgstr " Vorgeschlagene Produktcodes: {suggestions}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {product}/{version}/{action} was not found. Check the "
"product, version, and action."
msgstr ""
"Die Alibaba-Cloud-API {product}/{version}/{action} wurde nicht gefunden. "
"Prüfen Sie Produkt, Version und Aktion."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} was not found. Check the product, version, "
"and action."
msgstr ""
"Die Alibaba-Cloud-API {operation} wurde nicht gefunden. Prüfen Sie "
"Produkt, Version und Aktion."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API metadata for {operation} is temporarily unavailable; "
