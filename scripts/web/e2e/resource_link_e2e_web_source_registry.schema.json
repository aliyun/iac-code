{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iac-code.local/schemas/resource-link-e2e-web-source-registry-v1.json",
  "title": "Verified iac-code Web session query-source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "catalogRevisionDigest", "runnerRevisionDigest", "sourceKind",
    "evidenceDirectory", "evidenceManifestDigest", "evidenceFiles", "planBundle",
    "sessionIdDigest", "accountScopeDigest", "consolePartition", "counts", "entries"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "catalogRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runnerRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceKind": {"const": "iac_code_web_session_tool_result"},
    "evidenceDirectory": {"type": "string", "minLength": 1},
    "evidenceManifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceFiles": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "planBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "manifestDigest", "planPath", "planDigest", "planId"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planPath": {"type": "string", "minLength": 1},
        "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planId": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sessionIdDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accountScopeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consolePartition": {"const": "aliyun"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["contracts", "supplemented", "sampleLevelL2", "actualApiCalled"],
      "properties": {
        "contracts": {"type": "integer", "minimum": 1},
        "supplemented": {"type": "integer", "minimum": 0},
        "sampleLevelL2": {"type": "integer", "minimum": 0},
        "actualApiCalled": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "contractId", "resourceType", "canonicalResourceType", "product", "action",
          "responseIdentifierPath", "identifierField", "identifierDigest", "regionId",
          "accountScopeDigest", "consolePartition", "sessionIdDigest", "referenceId",
          "toolUseId", "messageId", "turnId", "sourcePath", "sourceKind", "sourceRequestDigest",
          "sourceRevision", "sourceEvidenceDigest", "requestParamFields", "rawToolResult",
          "replacedFailureReason", "replacedSourceEvidenceDigest", "sampleLevel",
          "actualApiCalled", "sourceChainStatus", "liveDestinationStatus", "catalogRevisionDigest"
        ],
        "properties": {
          "contractId": {"type": "string", "minLength": 1},
          "resourceType": {"type": "string", "pattern": "^ALIYUN::[A-Za-z0-9]+::[A-Za-z0-9]+$"},
          "canonicalResourceType": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "responseIdentifierPath": {"type": "string", "minLength": 1},
          "identifierField": {"type": "string", "minLength": 1},
          "identifierDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "regionId": {"type": "string", "minLength": 1},
          "accountScopeDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "consolePartition": {"const": "aliyun"},
          "sessionIdDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "referenceId": {"type": "string", "minLength": 1},
          "toolUseId": {"type": "string", "minLength": 1},
          "messageId": {"type": "string", "minLength": 1},
          "turnId": {"type": "string", "minLength": 1},
          "sourcePath": {"type": "string", "pattern": "^/result/.+"},
          "sourceKind": {"const": "tool_result"},
          "sourceRequestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "requestParamFields": {
            "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true
          },
          "rawToolResult": {
            "type": "object", "additionalProperties": false,
            "required": ["contentDigest", "contentLength", "isError", "contentTruncated", "requestDigest"],
            "properties": {
              "contentDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "contentLength": {"type": "integer", "minimum": 1},
              "isError": {"const": false},
              "contentTruncated": {"const": false},
              "requestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "replacedFailureReason": {"const": "missing_required_context"},
          "replacedSourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sampleLevel": {"const": "L2"},
          "actualApiCalled": {"const": true},
          "sourceChainStatus": {"const": "passed"},
          "liveDestinationStatus": {"const": "pending"},
          "catalogRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
