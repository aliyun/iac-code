"auf."

#: src/iac_code/tools/cloud/aliyun/template_source.py
#, python-brace-format
msgid ""
"ROS pipeline calls for {action} must use the dedicated ros_deploy tool "
"instead of aliyun_api. Do not call the raw ROS deployment API directly."
msgstr ""
"ROS-Pipeline-Aufrufe für {action} müssen das dedizierte Tool ros_deploy "
"anstelle von aliyun_api verwenden. Rufen Sie die rohe ROS-"
"Bereitstellungs-API nicht direkt auf."

#: src/iac_code/tools/cloud/aliyun/template_source.py
msgid ""
"ROS template calls must use TemplateURL instead of TemplateBody. Save the"
" template to a file and pass params.TemplateURL, for example a local file"
" path or OSS/HTTP URL."
msgstr ""
"ROS-Vorlagenaufrufe müssen TemplateURL statt TemplateBody verwenden. "
"Speichern Sie die Vorlage in einer Datei und übergeben Sie "
"params.TemplateURL, zum Beispiel einen lokalen Dateipfad oder eine OSS"
"/HTTP-URL."

#: src/iac_code/tools/cloud/aliyun/template_source.py
#, python-brace-format
msgid ""
"ROS pipeline calls for {action} must pass params.TemplateURL. Save the "
"template to a file and pass params.TemplateURL, for example a local file "
"path or OSS/HTTP URL."
msgstr ""
"ROS-Pipeline-Aufrufe für {action} müssen params.TemplateURL übergeben. "
"Speichern Sie die Vorlage in einer Datei und übergeben Sie "
"params.TemplateURL, zum Beispiel einen lokalen Dateipfad oder eine OSS"
"/HTTP-URL."

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "The local ROS template file cannot be read."
msgstr "Die lokale ROS Template-Datei kann nicht gelesen werden."

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "The local ROS template file is not valid UTF-8."
msgstr "Die lokale ROS Vorlagendatei ist nicht gültig UTF-8."

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid ""
"TemplateURL/local TemplateBody failed before entering the Parser; the ROS"
" API was not called."
msgstr ""
"TemplateURL/local TemplateBody scheiterte vor dem Betreten des Parsers; "
"der ROS API wurde nicht aufgerufen."

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "Confirm that the file exists, is readable, and is saved as UTF-8."
msgstr ""
"Bestätigen Sie, dass die Datei vorhanden ist, lesbar ist und als UTF-8 "
"gespeichert ist."

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template YAML syntax error: {}"
msgstr "YAML-Syntaxfehler in der Vorlage: {}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template YAML syntax error (line {line}, column {col}): {problem}"
msgstr "Meldebogen YAML Syntaxfehler (Zeile {line}, Spalte {col}): {problem}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template JSON syntax error (line {line}, column {col}): {msg}"
msgstr "JSON-Syntaxfehler in der Vorlage (Zeile {line}, Spalte {col}): {msg}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "Template parse failed"
msgstr "Meldebogen Parse gescheitert"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid ""
"Template parse result is not an object (dict), please check the template "
"format"
msgstr ""
"Template Parse Ergebnis ist kein Objekt (Dict), bitte überprüfen Sie das "
"Template Format"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Trusted ROS account context is missing, so the Module registration "
"account boundary cannot be verified."
msgstr ""
"Der vertrauenswürdige ROS-Kontokontext fehlt, so dass die Module-"
"Registrierungskontogrenze nicht überprüft werden kann."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Local structure and function semantics were validated; account "
"consistency requires trusted host context."
msgstr ""
"Die Struktur- und Funktionssemantik von Local wurde validiert; die "
"Kontokonsistenz erfordert einen vertrauenswürdigen Host-Kontext."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "PreviewStack has an invalid number of template sources."
msgstr "PreviewStack hat eine ungültige Anzahl von Vorlagenquellen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Creating a preview requires one source; updating a preview accepts zero "
"or one source."
msgstr ""
"Das Erstellen einer Vorschau erfordert eine Quelle; das Aktualisieren "
"einer Vorschau akzeptiert Null oder eine Quelle."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "PreviewStack must provide Parameters when reusing the existing template."
msgstr ""
"PreviewStack muss Parameters bereitstellen, wenn Sie das vorhandene "
"Template wiederverwenden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"A source-less update preview reuses the template only when Parameters is "
"provided."
msgstr ""
"Eine quellenlose Updatevorschau verwendet die Vorlage nur wieder, wenn "
"Parameters bereitgestellt wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ContinueCreateStack.Mode is invalid."
msgstr "ContinueCreateStack.Mode ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "Mode must be Recreate or Ignore."
msgstr "Mode muss Recreate oder Ignore sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ContinueCreateStack provides multiple template sources."
msgstr "ContinueCreateStack bietet mehrere Vorlagenquellen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "Recreate accepts at most one source."
msgstr "Recreate akzeptiert höchstens eine Quelle."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The CreateChangeSet template source does not match ChangeSetType."
msgstr "Die Vorlagenquelle CreateChangeSet stimmt nicht mit ChangeSetType überein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Select one of Body, URL, or TemplateId; ScratchId is valid only for "
"IMPORT of a new stack."
msgstr ""
"Wählen Sie Body, URL oder TemplateId aus; ScratchId ist nur für IMPORT "
"eines neuen Stacks gültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "GetTemplateRecommendParameters has an invalid template source."
msgstr "GetTemplateRecommendParameters hat eine ungültige Vorlagenquelle."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Provide at least one source, and do not provide TemplateBody and "
"TemplateURL together."
msgstr ""
"Geben Sie mindestens eine Quelle an und stellen Sie TemplateBody und "
"TemplateURL nicht zusammen bereit."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"GetTemplateRecommendParameters provides TemplateId together with a "
"higher-priority source."
msgstr ""
"GetTemplateRecommendParameters stellt TemplateId zusammen mit einer "
"Quelle mit höherer Priorität bereit."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"ROS prefers TemplateBody/TemplateURL, so TemplateId is ignored in this "
"call."
msgstr ""
"ROS bevorzugt TemplateBody/TemplateURL, daher wird TemplateId in diesem "
"Aufruf ignoriert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ListStackOperationRisks.OperationType is invalid."
msgstr "ListStackOperationRisks.OperationType ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The locked SDK declares only CreateStack and DeleteStack."
msgstr "Das gesperrte SDK deklariert nur CreateStack und DeleteStack."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The ListStackOperationRisks source does not match OperationType."
msgstr "Die ListStackOperationRisks Quelle stimmt nicht mit OperationType überein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"CreateStack requires one template source; DeleteStack accepts only "
"StackId."
msgstr ""
"CreateStack erfordert eine Vorlagenquelle; DeleteStack akzeptiert nur "
"StackId."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "CreateStackGroup cannot provide Parameters when StackArn is used."
msgstr ""
"CreateStackGroup kann Parameters nicht bereitstellen, wenn StackArn "
"verwendet wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"StackArn references an existing stack template, so Parameters is "
"ineffective in this branch."
msgstr ""
"StackArn verweist auf eine vorhandene Stapelvorlage, so dass Parameters "
"in diesem Branch ineffektiv ist."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "CreateStackGroup must use SELF_MANAGED when StackArn is used."
msgstr ""
"CreateStackGroup muss SELF_MANAGED verwenden, wenn StackArn verwendet "
"wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The SERVICE_MANAGED branch does not accept StackArn as a template source."
msgstr "Der SERVICE_MANAGED-Zweig akzeptiert StackArn nicht als Vorlagenquelle."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Local template analysis for RegisterResourceType supports only "
"EntityType=Module."
msgstr ""
"Local Template Analyse für RegisterResourceType unterstützt nur "
"EntityType=Module."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "EntityType is not Module."
msgstr "EntityType ist nicht Module."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "RegisterResourceType.ResourceType has an invalid format."
msgstr "RegisterResourceType.ResourceType hat ein ungültiges Format."

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"It must contain 18 to 100 characters and match "
"MODULE::Organization::Service::Type."
