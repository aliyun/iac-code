#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Rename one declaration and update its references."
msgstr "Benennen Sie eine Erklärung um und aktualisieren Sie ihre Referenzen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Resource {} Count is not a non-negative integer."
msgstr "Resource {} Count ist keine nicht negative ganze Zahl."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Count accepts an Integer, a String accepted by int(), or a dynamic "
"expression returning either value; the current type is deterministically "
"incompatible."
msgstr ""
"Count akzeptiert einen Integer, einen String, der von int() akzeptiert "
"wird, oder einen dynamischen Ausdruck, der entweder einen Wert "
"zurückgibt; der aktuelle Typ ist deterministisch inkompatibel."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Resource {} Count uses a String value."
msgstr "Resource {} Count verwendet einen String-Wert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime accepts a convertible String through int(); STRICT "
"mode recommends using Number/Integer directly."
msgstr ""
"Der gesperrte runtime akzeptiert ein konvertierbares String durch int(); "
"der STRICT-Modus empfiehlt die direkte Verwendung von Number/Integer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Change Count to an unquoted non-negative integer."
msgstr "Ändern Sie Count in eine nicht zitierte nicht negative Ganzzahl."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Dynamic Count may conflict with explicit resource {}."
msgstr "Dynamisches Count kann mit der expliziten Ressource {} in Konflikt stehen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Count length is unknown locally; instance-name collisions can be "
"determined only after deployment parameters are known."
msgstr ""
"Count Länge ist lokal unbekannt; Instanz-Name-Kollisionen können nur "
"bestimmt werden, nachdem Bereitstellungsparameter bekannt sind."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Expanded Count name {} conflicts with an explicit resource."
msgstr ""
"Der erweiterte Count-Name {} steht in Konflikt mit einer expliziten "
"Ressource."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Full precompilation would generate a resource instance with the same name."
msgstr ""
"Die vollständige Vorkompilierung würde eine Ressourceninstanz mit "
"demselben Namen erzeugen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Rule Assert is known to be false."
msgstr "Der Rule Assert ist bekanntlich falsch."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This assertion will cause template validation to fail{}."
msgstr "Diese Behauptung führt dazu, dass die Vorlagenvalidierung fehlschlägt{}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Correct the Parameter default, RuleCondition, or Assert expression."
msgstr ""
"Korrigieren Sie den Parameter-Standard, RuleCondition oder Assert-"
"Ausdruck."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Rules.{} returns {}; explicitly returning Boolean is recommended."
msgstr "Rules.{} gibt {} zurück; es wird ausdrücklich Boolean zurückgegeben."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime uses truthiness for RuleCondition and fails Assert only when "
"its result is exactly False; this is retained as a compatibility "
"extension."
msgstr ""
"Der runtime verwendet Wahrhaftigkeit für RuleCondition und schlägt Assert"
" nur dann fehl, wenn sein Ergebnis genau falsch ist; dies wird als "
"Kompatibilitätserweiterung beibehalten."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "A nonexistent Condition {} is referenced."
msgstr "Es wird auf ein nicht vorhandenes Condition {} verwiesen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Condition name must be declared in the Conditions section."
msgstr "Der Condition-Name muss im Abschnitt Conditions deklariert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS template exceeds the local semantic-analysis budget."
msgstr "Die ROS-Vorlage übersteigt das lokale Budget für semantische Analysen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Incomplete analysis has stopped and the API call has been blocked."
msgstr ""
"Die unvollständige Analyse wurde gestoppt und der API-Aufruf wurde "
"blockiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "ROS function nesting exceeds 20 levels."
msgstr "ROS Funktion Nesting überschreitet 20 Ebenen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "ROS does not accept a function at level 21."
msgstr "ROS akzeptiert keine Funktion auf Level 21."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Expression type {} is incompatible with its consumer position."
msgstr "Der Ausdruckstyp {} ist mit seiner Verbraucherposition nicht kompatibel."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This position requires {}."
msgstr "Diese Position erfordert {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Unknown ROS function {}."
msgstr "Unbekannte ROS Funktion {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "This name is not in the registry of 43 ROS 2015-09-01 runtime functions."
msgstr ""
"Dieser Name ist nicht in der Registrierung von 43 ROS 2015-09-01 runtime "
"Funktionen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Check the function name."
msgstr "Überprüfen Sie den Funktionsnamen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Function {} cannot be used in {} context."
msgstr "Die Funktion {} kann nicht im {}-Kontext verwendet werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"ROS registers different function tables for normal expressions, "
"Conditions/Rules, and Count."
msgstr ""
"ROS registriert verschiedene Funktionstabellen für normale Ausdrücke, "
"Conditions/Rules und Count."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A Module registration template cannot use Fn::GetStackOutput."
msgstr "Eine Module-Registrierungsvorlage kann Fn::GetStackOutput nicht verwenden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Module registration cannot depend on the runtime output of another Stack."
msgstr ""
"Die Module-Registrierung kann nicht vom runtime-Ausgang eines anderen "
"Stack abhängen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Select cannot select an element during Count precompilation."
msgstr "Fn::Select kann während der Count-Vorkompilierung kein Element auswählen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The known arguments of {} cannot be evaluated under the ROS runtime "
"contract."
msgstr ""
"Die bekannten Argumente von {} können nicht unter dem ROS runtime Vertrag"
" bewertet werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Local precomputation failed at the {} boundary; the remaining independent"
" expressions will still be validated."
msgstr ""
"Die Local-Vorberechnung ist an der {}-Grenze fehlgeschlagen; die "
"verbleibenden unabhängigen Ausdrücke werden weiterhin validiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} has an invalid argument shape."
msgstr "{} hat eine ungültige Argumentform."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The runtime requires {}."
msgstr "Der runtime erfordert {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} argument {} has incompatible type {}."
msgstr "{} Argument {} hat inkompatible Typ {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This argument requires {}."
msgstr "Dieses Argument erfordert {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} argument {} uses Boolean as Integer."
msgstr "{} Argument {} verwendet Boolean als Integer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The ROS Python runtime accepts this value, but an explicit Integer is "
"clearer and better matches the official template contract."
msgstr ""
"Der ROS Python runtime akzeptiert diesen Wert, aber ein explizites "
"Integer ist klarer und passt besser zum offiziellen Vorlagenvertrag."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The known result of {} is a non-finite Number."
msgstr "Das bekannte Ergebnis von {} ist ein nicht endliches Number."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime returns NaN/Infinity, but that value violates standard"
" JSON and the official template numeric constraints."
msgstr ""
"Der gesperrte runtime gibt NaN/Infinity zurück, aber dieser Wert verstößt"
" gegen Standard JSON und die offiziellen numerischen Einschränkungen der "
"Vorlage."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} List members must be hashable."
msgstr "{} List Mitglieder müssen hashable sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime checks each item for hashability before comparing collections."
msgstr ""
"Der runtime überprüft jedes Element auf Hash-Fähigkeit, bevor er "
"Sammlungen vergleicht."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} uses a runtime-only non-List Iterable outer container."
msgstr "{} verwendet einen runtime-nur nicht-List Iterable äußeren Container."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked constructor unpacks by iteration order; the official template "
"contract recommends a List."
msgstr ""
"Das gesperrte constructor wird per Iterationsreihenfolge entpackt; der "
"offizielle Vorlagenvertrag empfiehlt ein List."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} uses a runtime-only indexable Mapping outer container."
msgstr "{} verwendet einen runtime-nur indexierbaren Mapping äußeren Container."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The locked implementation indexes this container from 0 through {}; the "
"official template contract recommends a List."
msgstr ""
"Die gesperrte Implementierung indiziert diesen Container von 0 bis {}; "
"der offizielle Vorlagenvertrag empfiehlt ein List."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Function-form Ref resolves to {}, which is not a visible Parameter."
msgstr ""
"Die Funktionsform Ref wird in {} aufgelöst, was kein sichtbares Parameter"
" ist."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The Ref factory selects ParamRef before function evaluation; it does not "
"switch to ResourceRef when the result is a resource name."
msgstr ""
"Die Ref-Fabrik wählt vor der Funktionsauswertung ParamRef aus; sie "
"wechselt nicht zu ResourceRef, wenn das Ergebnis ein Ressourcenname ist."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Ref ALIYUN::Index can be used only in a resource that declares Count."
msgstr ""
"Ref ALIYUN::Index kann nur in einer Ressource verwendet werden, die Count"
" deklariert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This pseudo parameter is visible only in rewritable content of a Count "
"resource instance."
msgstr ""
"Dieser Pseudoparameter ist nur im wiederbeschreibbaren Inhalt einer "
"Count-Ressourceninstanz sichtbar."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} contains Ref {}, which cannot reference a Local."
msgstr "{} enthält Ref {}, das nicht auf ein Local verweisen kann."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"ROS Local precompilation replaces only resource Count and Properties; "
"names in this field are resolved as Parameter Ref."
msgstr ""
"ROS Local-Vorkompilierung ersetzt nur die Ressource Count und Properties;"
" Namen in diesem Feld werden als Parameter Ref aufgelöst."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "A temporary Local Stack cannot reference outer resource {}."
msgstr ""
"Ein temporäres Local Stack kann nicht auf die äußere Ressource {} "
"verweisen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The temporary Eval/DataSource Local template copies only Parameters and "
"Locals, not outer Resources/DataSources."
msgstr ""
"Die temporäre Eval/DataSource Local Vorlage kopiert nur Parameters und "
"Locals, nicht äußere Resources/DataSources."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Count resource {} expands into multiple instances, but this Ref cannot be"
" automatically rewritten into an instance list."
msgstr ""
"Count-Ressource {} wird in mehrere Instanzen erweitert, aber diese Ref "
"kann nicht automatisch in eine Instanzliste umgeschrieben werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Place Ref in an expandable expression under resource Properties or "
"Outputs, or reference an explicit instance such as {}[0]."
msgstr ""
"Platzieren Sie Ref in einem erweiterbaren Ausdruck unter Ressource "
"Properties oder Outputs oder verweisen Sie auf eine explizite Instanz wie"
" {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Ref references nonexistent symbol {}."
msgstr "Ref verweist auf nicht vorhandenes Symbol {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The name does not appear in Parameters, Resources, Locals, or pseudo "
"parameters."
msgstr ""
"Der Name erscheint nicht in Parameters, Resources, Locals oder "
"Pseudoparametern."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Correct the logical name or add the missing declaration."
msgstr ""
"Korrigieren Sie den logischen Namen oder fügen Sie die fehlende Erklärung"
" hinzu."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "ParamRef in {} context uses a non-String parameter key."
msgstr "ParamRef verwendet im {}-Kontext einen nicht-String-Parameterschlüssel."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime can look up a HashableScalar, but the official "
"parameter-name and Ref contracts use String."
msgstr ""
"Der gesperrte runtime kann einen HashableScalar nachschlagen, aber der "
"offizielle Parametername und die Ref-Verträge verwenden String."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} context contains Ref {}, which is not a visible Parameter."
msgstr "Der {}-Kontext enthält Ref {}, was kein sichtbares Parameter ist."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This context uses ParamRef; normal Resource/DataSource values are not "
"allowed, and List/Map cannot be used as parameter keys."
msgstr ""
"Dieser Kontext verwendet ParamRef; normale Resource/DataSource-Werte sind"
" nicht erlaubt und List/Map können nicht als Parameterschlüssel verwendet"
" werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Whether Count instance reference {} exists cannot be determined locally."
msgstr "Ob Count Instanzreferenz {} existiert, kann nicht lokal bestimmt werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Count length is determined by a dynamic expression; if an instance exists"
" at deployment time, this reference returns a single-instance value."
msgstr ""
"Count Länge wird durch einen dynamischen Ausdruck bestimmt; wenn eine "
"Instanz zum Bereitstellungszeitpunkt existiert, gibt diese Referenz einen"
" Einzelinstanzwert zurück."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "DataSource Local {} cannot remain in the final template scope."
msgstr "DataSource Local {} kann nicht im endgültigen Vorlagenumfang verbleiben."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A DataSource Local is visible only inside the Local dependency graph."
msgstr ""
"Ein DataSource Local ist nur innerhalb des Local Abhängigkeitsgraphen "
"sichtbar."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "DataSource Local {} cannot use Fn::GetAtt in final template scope."
msgstr ""
"DataSource Local {} kann Fn::GetAtt nicht im endgültigen Vorlagenumfang "
"verwenden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"A DataSource Local is visible only in the temporary Stack for the Local "
"dependency graph."
msgstr ""
"Ein DataSource Local ist nur im temporären Stack für das Local-"
"Abhängigkeitsgraph sichtbar."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "A temporary Local Stack cannot read attributes of outer resource {}."
msgstr ""
"Ein temporäres Local Stack kann keine Attribute der äußeren Ressource {} "
"lesen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The temporary Eval/DataSource Local template does not copy outer "
"Resources/DataSources."
msgstr ""
"Die temporäre Eval/DataSource Local Vorlage kopiert keine äußeren "
"Resources/DataSources."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::GetAtt references nonexistent resource {}."
msgstr "Fn::GetAtt verweist auf nicht vorhandene Ressource {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The resource logical name or Count instance name is invalid."
msgstr "Der logische Ressourcenname oder Count-Instanzname ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Fn::GetAtt for nested stack {} must use "
"Outputs.<nested_stack_output_name>."
msgstr ""
"Fn::GetAtt für den verschachtelten Stack {} muss "
"Outputs.<nested_stack_output_name> verwenden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"ALIYUN::ROS::Stack exposes child stack outputs only through the fixed "
"Outputs. prefix, followed by a non-empty output name."
msgstr ""
"ALIYUN::ROS::Stack stellt Ausgaben des untergeordneten Stacks nur über "
"das feste Präfix Outputs. bereit, gefolgt von einem nicht leeren "
"Ausgabenamen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Change the second argument to Outputs.<nested_stack_output_name>, for "
"example Fn::GetAtt: [{}, Outputs.MyOutput]."
msgstr ""
"Ändern Sie das zweite Argument in Outputs.<nested_stack_output_name>, zum"
" Beispiel Fn::GetAtt: [{}, Outputs.MyOutput]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Count resource {} expands into multiple instances, but this Fn::GetAtt "
"cannot be automatically rewritten into an attribute list."
msgstr ""
"Count-Ressource {} wird in mehrere Instanzen erweitert, aber diese "
"Fn::GetAtt kann nicht automatisch in eine Attributliste umgeschrieben "
"werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Use Fn::GetAtt: [{}, attribute-name] in an expandable expression under "
"resource Properties or Outputs, or reference an explicit instance such as"
" {}[0]."
msgstr ""
"Verwenden Sie Fn::GetAtt: [{}, attribute-name] in einem erweiterbaren "
"Ausdruck unter Ressource Properties oder Outputs oder verweisen Sie auf "
"eine explizite Instanz wie {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A List condition cannot be empty."
msgstr "Eine List-Bedingung kann nicht leer sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A Map condition must contain a Condition key."
msgstr "Eine Map-Bedingung muss einen Condition-Schlüssel enthalten."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "condition must resolve to Boolean, String, List, or Map."
msgstr "Die Bedingung muss in Boolean, String, List oder Map aufgelöst werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key must resolve to String or Boolean."
msgstr "Der Bedingungsschlüssel muss in String oder Boolean aufgelöst werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key cannot be Null."
msgstr "Der Bedingungsschlüssel kann nicht Null sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key must be a String or Boolean."
msgstr "Der Bedingungsschlüssel muss ein String oder Boolean sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The known Fn::If condition cannot be evaluated under the ROS runtime "
"contract."
msgstr ""
"Die bekannte Fn::If Bedingung kann nicht unter dem ROS runtime Vertrag "
"bewertet werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} in a plain string is not expanded by ROS."
msgstr "{} in einem einfachen String wird nicht durch ROS erweitert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Only Fn::Sub expands ${...}; the current function treats it as a literal "
"string."
msgstr ""
"Nur Fn::Sub erweitert ${...}; die aktuelle Funktion behandelt es als "
"Literalstring."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Use Ref/Fn::GetAtt, or place the string inside Fn::Sub."
msgstr "Verwenden Sie Ref/Fn::GetAtt oder legen Sie den String in Fn::Sub."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Select uses a runtime-only non-List outer container."
msgstr "Fn::Select verwendet einen runtime-nur nicht-List äußeren Container."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked constructor can unpack exactly two members; the official "
"template contract recommends a List."
msgstr ""
"Das gesperrte constructor kann genau zwei Mitglieder auspacken; der "
"offizielle Vorlagenvertrag empfiehlt ein List."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Mapping key for Fn::FindInMap does not exist."
msgstr "Der literale Mapping-Schlüssel für Fn::FindInMap existiert nicht."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "No entry was found in map-name, top-key, second-key order."
msgstr ""
"Es wurde kein Eintrag in der Reihenfolge map-name, top-key, second-key "
"gefunden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::GetAZs is consumed outside the official ECS/VPC scope."
msgstr "Fn::GetAZs wird außerhalb des offiziellen ECS/VPC-Bereichs konsumiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime does not restrict this consumer position, so this is reported"
" only as a quality difference."
msgstr ""
"Das runtime schränkt diese Verbraucherposition nicht ein, so dass dies "
"nur als Qualitätsunterschied gemeldet wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::ResourceFacade has no parent_resource in a top-level template."
msgstr "Fn::ResourceFacade hat in einer Top-Level-Vorlage keine parent_resource."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "This internal function can be evaluated only in a resource facade context."
msgstr ""
"Diese interne Funktion kann nur in einem Ressourcenfassadenkontext "
"ausgewertet werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Join collection uses Boolean as Integer text."
msgstr "Die Fn::Join-Sammlung verwendet Boolean als Integer-Text."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime inherits Python bool/int semantics; convert it explicitly "
"first."
msgstr ""
"Die runtime erbt Python bool/int Semantik; konvertieren Sie es explizit "
"zuerst."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Join collection contains an item that cannot be joined."
msgstr ""
"Die Fn::Join-Sammlung enthält ein Element, das nicht verbunden werden "
"kann."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Only String, Integer, Boolean, and Null are accepted."
msgstr "Es werden nur String, Integer, Boolean und Null akzeptiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Split delimiter cannot be empty."
msgstr "Der Fn::Split Trennzeichen kann nicht leer sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Python split('') raises an empty separator error."
msgstr "Python split('') löst einen leeren Separatorfehler aus."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::Replace replacement key must be a String."
msgstr "Ein Fn::Replace-Ersatzschlüssel muss ein String sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A non-Null template consumes the key with replace()."
msgstr "Eine Nicht-Null Vorlage verbraucht den Schlüssel mit replace()."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The constant Fn::Base64Decode input does not match the ROS Base64 format."
msgstr ""
"Der konstante Fn::Base64Decode-Eingang entspricht nicht dem ROS "
"Base64-Format."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Input must be non-empty and match the locked runtime padding regex; only "
"one trailing newline accepted by regex `$` is allowed."
msgstr ""
"Die Eingabe muss nicht leer sein und dem gesperrten runtime-Pading-Regex "
"entsprechen; nur eine von regex \"$\" akzeptierte Trailing-Newline ist "
"zulässig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The constant Fn::Base64Decode input is invalid."
msgstr "Der konstante Fn::Base64Decode Eingang ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Input must be non-empty Base64 that decodes as UTF-8."
msgstr "Der Eingang muss nicht leer Base64 sein, der als UTF-8 dekodiert wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Str container cannot be JSON-serialized."
msgstr "Der Fn::Str Container kann nicht JSON-serialisiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The container contains an unsupported key or value."
msgstr "Der Container enthält einen nicht unterstützten Schlüssel oder Wert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Sub variable-map keys must be Strings."
msgstr "Fn::Sub variable Kartenschlüssel müssen Strings sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The Sub constructor iterates over and validates every variable name "
"before evaluation."
msgstr ""
"Der Sub constructor iteriert und validiert jeden Variablennamen vor der "
"Auswertung."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Sub Parameter Ref result cannot be converted to String."
msgstr ""
"Das Ergebnis Fn::Sub Parameter Ref kann nicht in String konvertiert "
"werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS constructor calls to_string on the ParamRef result first."
msgstr ""
"Der ROS constructor ruft to_string zuerst auf dem Ergebnis von ParamRef "
"auf."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Sub variable name does not match the runtime syntax."
msgstr "Der Name der Fn::Sub-Variable stimmt nicht mit der runtime-Syntax überein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The ${...} content must contain at least one name matched by "
"SUB_STRING_PATTERN."
msgstr ""
"Der ${...}-Inhalt muss mindestens einen Namen enthalten, der mit "
"SUB_STRING_PATTERN übereinstimmt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub variable {} cannot be JSON-serialized."
msgstr "Fn::Sub Variable {} kann nicht JSON-serialisiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A used List/Map variable enters the runtime to_string JSON branch."
msgstr ""
"Eine verwendete List/Map-Variable tritt in den runtime to_string JSON-"
"Zweig ein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"{} in Fn::Sub references a Count resource that expands into multiple "
"instances; ROS cannot determine which instance attribute to read."
msgstr ""
"{} in Fn::Sub verweist auf eine Count-Ressource, die in mehrere Instanzen"
" erweitert wird; ROS kann nicht bestimmen, welches Instanzattribut "
"gelesen werden soll."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Use an expandable Fn::GetAtt in the variable map, or reference an "
"explicit instance such as {}[0]."
msgstr ""
"Verwenden Sie ein erweiterbares Fn::GetAtt in der Variablenkarte oder "
"verweisen Sie auf eine explizite Instanz wie {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub references nonexistent resource attribute {}."
msgstr "Fn::Sub verweist auf nicht vorhandenes Ressourcenattribut {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The implicit GetAtt cannot bind to a resource."
msgstr "Das implizite GetAtt kann nicht an eine Ressource binden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"{} in Fn::Sub references a Count resource that expands into multiple "
"instances; ROS cannot determine which instance to use."
msgstr ""
"{} in Fn::Sub verweist auf eine Count-Ressource, die in mehrere Instanzen"
" erweitert wird; ROS kann nicht bestimmen, welche Instanz verwendet "
"werden soll."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Use an expandable Ref in the variable map, or reference an explicit "
"instance such as {}[0]."
msgstr ""
"Verwenden Sie ein erweiterbares Ref in der Variablenkarte oder verweisen "
"Sie auf eine explizite Instanz wie {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub references nonexistent symbol {}."
msgstr "Fn::Sub verweist auf nicht vorhandenes Symbol {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The name does not exist in either the variable map or the template symbol"
" table."
msgstr ""
"Der Name existiert weder in der Variablenkarte noch in der "
"Vorlagensymboltabelle."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub variable {} is not used by the template."
msgstr "Fn::Sub Variable {} wird von der Vorlage nicht verwendet."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Unused variables do not affect the result."
msgstr "Nicht verwendete Variablen beeinflussen das Ergebnis nicht."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Integer argument {} of Fn::Indent is out of range."
msgstr "Integer Argument {} von Fn::Indent ist außerhalb des Bereichs."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The allowed range is 0 to {}."
msgstr "Der zulässige Bereich ist 0 bis {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth argument of Fn::Indent should be a Boolean."
msgstr "Das vierte Argument von Fn::Indent sollte ein Boolean sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime uses truthy semantics, but an explicit Boolean is clearer."
msgstr ""
"Das runtime verwendet wahrheitsgemäße Semantik, aber ein explizites "
"Boolean ist klarer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::FormatTime time zone is invalid."
msgstr "Die Zeitzone Fn::FormatTime ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime requires time_zone to be recognized by the time-zone "
"database."
msgstr ""
"Das gesperrte runtime erfordert, dass time_zone von der "
"Zeitzonendatenbank erkannt wird."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::MatchPattern regular expression is invalid."
msgstr "Der reguläre Ausdruck Fn::MatchPattern ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal pattern cannot be compiled."
msgstr "Das wörtliche Muster kann nicht kompiliert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth Fn::Select argument must be a raw String or Null."
msgstr "Das vierte Fn::Select-Argument muss ein roher String oder Null sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"error_message is checked during construction, regardless of whether the "
"key matches."
msgstr ""
"error_message wird während des Baus überprüft, unabhängig davon, ob der "
"Schlüssel übereinstimmt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Select key/index did not match."
msgstr "Der wörtliche Fn::Select-Schlüssel/Index stimmte nicht überein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth error_message is not Null, so the runtime reports an error."
msgstr ""
"Das vierte error_message ist nicht Null, daher meldet das runtime einen "
"Fehler."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Select key/index is invalid."
msgstr "Der literale Fn::Select Schlüssel/Index ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The value cannot be converted to an Integer, a valid slice, or the key "
"required by the collection."
msgstr ""
"Der Wert kann nicht in einen Integer, einen gültigen Slice oder den von "
"der Sammlung benötigten Schlüssel konvertiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The second Fn::Select argument is definitively {}, which cannot be used "
"as a collection."
msgstr ""
"Das zweite Fn::Select-Argument ist definitiv {}, das nicht als Sammlung "
"verwendet werden kann."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This argument must be List, Map, Null, EmptyString, or a String that "
"decodes to JSON List/Map/Null."
msgstr ""
"Dieses Argument muss List, Map, Null, EmptyString oder ein String sein, "
"das in JSON List/Map/Null decodiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Make the second argument return an actual collection, or remove "
"Fn::Select."
msgstr ""
"Lassen Sie das zweite Argument eine tatsächliche Sammlung zurückgeben, "
"oder entfernen Sie Fn::Select."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The first two Fn::MemberListToMap arguments must be raw Strings."
msgstr "Die ersten beiden Fn::MemberListToMap-Argumente müssen rohe Strings sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The name and value field names are consumed during construction."
msgstr "Die Namens- und Wertfeldnamen werden während der Konstruktion verbraucht."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::MemberListToMap members must be Strings."
msgstr "Fn::MemberListToMap-Mitglieder müssen Strings sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime calls split('=', 1) for every item."
msgstr "Der runtime ruft split('=', 1) für jedes Element auf."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MemberListToMap member is missing an equals sign."
msgstr "Einem Fn::MemberListToMap-Mitglied fehlt ein Gleichheitszeichen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The member cannot be converted to the key/value pair required by dict()."
msgstr ""
"Das Mitglied kann nicht in das von dict() benötigte Schlüssel/Wert-Paar "
"konvertiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::GetJsonValue has an invalid JSON String."
msgstr "Fn::GetJsonValue hat eine ungültige JSON String."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The second argument cannot be decoded as a JSON object."
msgstr "Das zweite Argument kann nicht als JSON Objekt dekodiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The value selected by Fn::GetJsonValue cannot be JSON-serialized."
msgstr ""
"Der von Fn::GetJsonValue ausgewählte Wert kann nicht JSON-serialisiert "
"werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Only the selected non-String cell enters json.dumps."
msgstr "Nur die ausgewählte Nicht-String-Zelle tritt in json.dumps ein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MergeMapToList Map contains more than one valid key/value pair."
msgstr ""
"Ein Fn::MergeMapToList Map enthält mehr als ein gültiges Schlüssel/Wert-"
"Paar."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The locked runtime rejects this Map before the second non-empty value."
msgstr ""
"Der gesperrte runtime weist diesen Map vor dem zweiten nicht-leeren Wert "
"zurück."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MergeMapToList Map value must be List or Null."
msgstr "Ein Fn::MergeMapToList Map-Wert muss List oder Null sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Null is treated as ['']; other types fail deterministically at runtime."
msgstr ""
"Null wird als [''] behandelt; andere Typen scheitern deterministisch an "
"runtime."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::SelectMapList key must be hashable."
msgstr "Der Fn::SelectMapList-Schlüssel muss hashbar sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime evaluates `key in map_item`; a List/Map key fails "
"deterministically."
msgstr ""
"Der runtime wertet `key in map_item` aus; ein List/Map-Schlüssel schlägt "
"deterministisch fehl."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::SelectMapList collection members must be Maps or Null."
msgstr "Fn::SelectMapList-Sammlungsmitglieder müssen Maps oder Null sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Null is skipped; other types cannot participate in key lookup."
msgstr ""
"Null wird übersprungen; andere Typen können nicht an der Schlüsselsuche "
"teilnehmen."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Jq method must be First or All."
msgstr "Die Fn::Jq-Methode muss First or All sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "method is checked during raw construction."
msgstr "Das Verfahren wird beim Rohbau überprüft."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Jq forbids $ENV in a raw script."
msgstr "Fn::Jq verbietet $ENV in einem Rohskript."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This regular-expression check occurs before function evaluation; the "
"result of a dynamic script is not checked here."
msgstr ""
"Diese Regular-Expression-Prüfung erfolgt vor der Funktionsauswertung; das"
" Ergebnis eines dynamischen Skripts wird hier nicht überprüft."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Jq has a non-empty String value that is not valid JSON."
msgstr "Fn::Jq hat einen nicht leeren String-Wert, der nicht gültig ist JSON."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime calls json.loads before executing jq."
msgstr "Der runtime ruft json.loads auf, bevor er jq ausführt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Jq value cannot be JSON-serialized."
msgstr "Der Fn::Jq-Wert kann nicht JSON-serialisiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"A value that is not short-circuited crosses the JSON boundary before the "
"jq backend."
msgstr ""
"Ein Wert, der nicht kurzgeschlossen ist, überschreitet die JSON-Grenze "
"vor dem jq-Backend."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::EachMemberIn List exceeds 10,000 items."
msgstr "Der Fn::EachMemberIn List übersteigt 10.000 Artikel."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime limits each collection to 10,000 items."
msgstr "Der runtime begrenzt jede Sammlung auf 10.000 Artikel."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"All Fn::Add arguments must be Numbers, Lists, or Maps of the same "
"category."
msgstr ""
"Alle Fn::Add-Argumente müssen Numbers, Lists oder Maps derselben "
"Kategorie sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The three operation branches cannot be mixed."
msgstr "Die drei Operationszweige können nicht gemischt werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Member {} of Fn::Avg cannot be converted to Float."
msgstr "Member {} von Fn::Avg kann nicht in Float umgewandelt werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The conversion result is {}."
msgstr "Das Umwandlungsergebnis ist {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The known Fn::Avg arguments fail during summation or rounding."
msgstr "Die bekannten Fn::Avg-Argumente scheitern beim Summieren oder Runden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS runtime cannot evaluate this literal numeric combination."
msgstr ""
"Die ROS runtime kann diese wörtliche numerische Kombination nicht "
"auswerten."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The non-finite Fn::Avg result cannot be converted to Integer."
msgstr ""
"Das nicht endliche Ergebnis von Fn::Avg kann nicht in Integer konvertiert"
" werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"When ndigits is at most 0, the runtime eventually calls int(); "
"NaN/Infinity fails deterministically."
msgstr ""
"Wenn ndigits höchstens 0 ist, ruft der runtime schließlich int() auf; "
"NaN/Infinity scheitert deterministisch."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Calculate expression is outside the safe allowlist."
msgstr "Der Ausdruck Fn::Calculate befindet sich außerhalb der Safe Allowlist."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The expression must be a raw String; ** and non-arithmetic characters are"
" forbidden."
msgstr ""
"Der Ausdruck muss ein roher String sein; ** und nicht-arithmetische "
"Zeichen sind verboten."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Calculate has an invalid placeholder format."
msgstr "Fn::Calculate hat ein ungültiges Platzhalterformat."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Only positional placeholders such as {0} and {1}, without conversions or "
"format specs, are allowed."
msgstr ""
"Nur Positionsplatzhalter wie {0} und {1} ohne Konvertierungen oder "
"Formatspezifikationen sind erlaubt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Calculate number {} failed preflight validation."
msgstr "Fn::Calculate Nummer {} fehlgeschlagen Preflight Validierung."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "float() produced {}; preflight runs before placeholder reachability."
msgstr "float() produzierte {}; Preflight läuft vor Platzhaltererreichbarkeit."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Calculate references a number placeholder that does not exist."
msgstr "Fn::Calculate verweist auf einen Nummernplatzhalter, der nicht existiert."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The maximum expression index is {}, but only {} numbers were provided."
msgstr ""
"Der maximale Expressionsindex ist {}, es wurden jedoch nur {}-Nummern "
"bereitgestellt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Calculate expression cannot be formatted with the raw numbers."
msgstr "Der Ausdruck Fn::Calculate kann nicht mit den Rohzahlen formatiert werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime calls expression.format(*numbers) before arithmetic "
"evaluation."
msgstr ""
"Der runtime ruft vor der arithmetischen Auswertung "
"expression.format(*numbers) auf."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The known Fn::Calculate expression cannot be evaluated under the runtime "
"arithmetic contract."
msgstr ""
"Der bekannte Fn::Calculate-Ausdruck kann nicht unter dem runtime-"
"Arithmetik-Kontrakt ausgewertet werden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The formatted result contains an invalid token, division by zero, "
"overflow, or a non-finite value that cannot be converted to Integer."
msgstr ""
"Das formatierte Ergebnis enthält ein ungültiges Token, eine Division "
"durch Null, einen Überlauf oder einen nicht endlichen Wert, der nicht in "
"Integer konvertiert werden kann."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Integer argument {} of Fn::Cidr is out of range."
msgstr "Integer Argument {} von Fn::Cidr ist außerhalb des Bereichs."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The allowed range is {} to {}."
msgstr "Der zulässige Bereich ist {} bis {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Cidr IPv4 network is invalid."
msgstr "Das literale Fn::Cidr IPv4 Netzwerk ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "ipBlock must be a valid IPv4 CIDR."
msgstr "ipBlock muss ein gültiges IPv4 CIDR sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Cidr network arguments are invalid."
msgstr "Die literalen Fn::Cidr-Netzwerkargumente sind ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"IPv4, count from 1 to 256, cidrBits from 1 to 32, and sufficient capacity"
" are required."
msgstr ""
"IPv4, von 1 bis 256, cidrBits von 1 bis 32, und es sind ausreichende "
"Kapazitäten erforderlich."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::TransformNamespace transform_type is invalid."
msgstr "Fn::TransformNamespace transform_type ist ungültig."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Only Condition or DependsOn is supported."
msgstr "Nur Condition oder DependsOn werden unterstützt."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::TransformNamespace Condition List cannot be empty."
msgstr "Der Fn::TransformNamespace Condition List kann nicht leer sein."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime reads the first member, so an empty List raises IndexError."
msgstr ""
"Der runtime liest das erste Mitglied, so dass ein leeres List IndexError "
"erhöht."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::TransformNamespace.DependsOn has an invalid Lookup value."
