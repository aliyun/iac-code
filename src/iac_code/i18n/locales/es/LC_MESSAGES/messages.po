msgstr "Una condición List no puede estar vacía."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A Map condition must contain a Condition key."
msgstr "Una condición Map debe contener una clave Condition."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "condition must resolve to Boolean, String, List, or Map."
msgstr "condición debe resolver a Boolean, String, List, o Map."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key must resolve to String or Boolean."
msgstr "La clave de condición debe resolverse a String o Boolean."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key cannot be Null."
msgstr "La clave de condición no puede ser Null."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The condition key must be a String or Boolean."
msgstr "La clave de condición debe ser un String o Boolean."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The known Fn::If condition cannot be evaluated under the ROS runtime "
"contract."
msgstr ""
"La conocida condición Fn::If no se puede evaluar en el contrato ROS "
"runtime."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} in a plain string is not expanded by ROS."
msgstr "{} en una cuerda plana no se expande por ROS."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Only Fn::Sub expands ${...}; the current function treats it as a literal "
"string."
msgstr ""
"Sólo Fn::Sub expande ${...}; la función actual la trata como una cadena "
"literal."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Use Ref/Fn::GetAtt, or place the string inside Fn::Sub."
msgstr "Use Ref/Fn::GetAtt, o coloque la cadena dentro de Fn::Sub."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Select uses a runtime-only non-List outer container."
msgstr "Fn::Select utiliza un contenedor exterior runtime-sólo no List."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked constructor can unpack exactly two members; the official "
"template contract recommends a List."
msgstr ""
"El constructor bloqueado puede desempacar exactamente dos miembros; el "
"contrato de plantilla oficial recomienda un List."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Mapping key for Fn::FindInMap does not exist."
msgstr "La clave literal Mapping para Fn::FindInMap no existe."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "No entry was found in map-name, top-key, second-key order."
msgstr "No se encontró entrada en mapa-nombre, top-key, segundo orden."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::GetAZs is consumed outside the official ECS/VPC scope."
msgstr "Fn::GetAZs se consume fuera del alcance oficial ECS/VPC."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime does not restrict this consumer position, so this is reported"
" only as a quality difference."
msgstr ""
"El runtime no restringe esta posición de consumo, por lo que esto se "
"reporta sólo como una diferencia de calidad."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::ResourceFacade has no parent_resource in a top-level template."
msgstr ""
"Fn::ResourceFacade no tiene parent_resource en una plantilla de nivel "
"superior."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "This internal function can be evaluated only in a resource facade context."
msgstr ""
"Esta función interna se puede evaluar sólo en un contexto de fachada de "
"recursos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Join collection uses Boolean as Integer text."
msgstr "La colección Fn::Join utiliza Boolean como texto Integer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime inherits Python bool/int semantics; convert it explicitly "
"first."
msgstr ""
"El runtime hereda Python bool/int semantics; convertirlo explícitamente "
"primero."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Join collection contains an item that cannot be joined."
msgstr "La colección Fn::Join contiene un artículo que no se puede unir."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Only String, Integer, Boolean, and Null are accepted."
msgstr "Sólo String, Integer, Boolean y Null son aceptados."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Split delimiter cannot be empty."
msgstr "El delimitador Fn::Split no puede estar vacío."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Python split('') raises an empty separator error."
msgstr "Python split('') plantea un error separador vacío."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::Replace replacement key must be a String."
msgstr "Una llave de reemplazo Fn::Replace debe ser una String."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A non-Null template consumes the key with replace()."
msgstr "Una plantilla no Null consume la clave con replace()."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The constant Fn::Base64Decode input does not match the ROS Base64 format."
msgstr ""
"La entrada Fn::Base64Decode constante no coincide con el formato ROS "
"Base64."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Input must be non-empty and match the locked runtime padding regex; only "
"one trailing newline accepted by regex `$` is allowed."
msgstr ""
"La entrada debe ser no vacía y coincidir con el sistema de padding "
"runtime bloqueado; sólo se permite una nueva línea de seguimiento "
"aceptada por regex `$`."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The constant Fn::Base64Decode input is invalid."
msgstr "La entrada Fn::Base64Decode constante es inválida."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Input must be non-empty Base64 that decodes as UTF-8."
msgstr "La entrada debe ser no vacía Base64 que decodifica como UTF-8."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Str container cannot be JSON-serialized."
msgstr "El contenedor Fn::Str no puede ser JSON-serializado."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The container contains an unsupported key or value."
msgstr "El contenedor contiene una clave o valor sin soporte."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Sub variable-map keys must be Strings."
msgstr "Las teclas de mapa variable Fn::Sub deben ser Strings."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The Sub constructor iterates over and validates every variable name "
"before evaluation."
msgstr ""
"El Sub constructor se completa y valida cada nombre variable antes de la "
"evaluación."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Sub Parameter Ref result cannot be converted to String."
msgstr "El resultado de Fn::Sub Parameter Ref no se puede convertir en String."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS constructor calls to_string on the ParamRef result first."
msgstr "El ROS constructor llama to_string en el resultado ParamRef primero."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Sub variable name does not match the runtime syntax."
msgstr "El nombre variable Fn::Sub no coincide con la sintaxis runtime."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The ${...} content must contain at least one name matched by "
"SUB_STRING_PATTERN."
msgstr ""
"El contenido de ${...} debe contener al menos un nombre que se "
"corresponda con SUB_STRING_PATTERN."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub variable {} cannot be JSON-serialized."
msgstr "Fn::Sub variable {} no puede ser JSON-serializada."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A used List/Map variable enters the runtime to_string JSON branch."
msgstr "Una variable List/Map entra en la rama runtime to_string JSON."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"{} in Fn::Sub references a Count resource that expands into multiple "
"instances; ROS cannot determine which instance attribute to read."
msgstr ""
"{} en Fn::Sub hace referencia a un recurso Count que se expande en varias"
" instancias; ROS no puede determinar qué atributo de instancia debe leer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Use an expandable Fn::GetAtt in the variable map, or reference an "
"explicit instance such as {}[0]."
msgstr ""
"Use un Fn::GetAtt expandible en el mapa variable, o consulte una "
"instancia explícita como {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub references nonexistent resource attribute {}."
msgstr "Fn::Sub referencias atributo de recursos inexistente {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The implicit GetAtt cannot bind to a resource."
msgstr "El implícito GetAtt no puede unirse a un recurso."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"{} in Fn::Sub references a Count resource that expands into multiple "
"instances; ROS cannot determine which instance to use."
msgstr ""
"{} en Fn::Sub hace referencia a un recurso Count que se expande en varias"
" instancias; ROS no puede determinar qué instancia debe usar."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Use an expandable Ref in the variable map, or reference an explicit "
"instance such as {}[0]."
msgstr ""
"Use un Ref expandible en el mapa variable, o consulte una instancia "
"explícita como {}[0]."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub references nonexistent symbol {}."
msgstr "Fn::Sub referencias símbolo inexistente {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The name does not exist in either the variable map or the template symbol"
" table."
msgstr ""
"El nombre no existe en el mapa variable o en la tabla de símbolos de "
"plantilla."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Sub variable {} is not used by the template."
msgstr "Fn::Sub variable {} no es utilizado por la plantilla."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Unused variables do not affect the result."
msgstr "Las variables no utilizadas no afectan el resultado."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Integer argument {} of Fn::Indent is out of range."
msgstr "Integer argumento {} de Fn::Indent está fuera de alcance."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The allowed range is 0 to {}."
msgstr "El rango permitido es de 0 a {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth argument of Fn::Indent should be a Boolean."
msgstr "El cuarto argumento de Fn::Indent debe ser un Boolean."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime uses truthy semantics, but an explicit Boolean is clearer."
msgstr ""
"El runtime utiliza semántica veraz, pero un Boolean explícito es más "
"claro."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::FormatTime time zone is invalid."
msgstr "La zona horaria Fn::FormatTime es inválida."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime requires time_zone to be recognized by the time-zone "
"database."
msgstr ""
"El runtime bloqueado requiere que time_zone sea reconocido por la base de"
" datos de la zona horaria."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::MatchPattern regular expression is invalid."
msgstr "La expresión regular Fn::MatchPattern es inválida."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal pattern cannot be compiled."
msgstr "El patrón literal no puede ser compilado."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth Fn::Select argument must be a raw String or Null."
msgstr "El cuarto argumento Fn::Select debe ser un String crudo o Null."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"error_message is checked during construction, regardless of whether the "
"key matches."
msgstr ""
"error_message se comprueba durante la construcción, independientemente de"
" si la clave coincide."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Select key/index did not match."
msgstr "El literal Fn::Select key/index no coincidió."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The fourth error_message is not Null, so the runtime reports an error."
msgstr ""
"El cuarto error_message no es Null, por lo que el runtime reporta un "
"error."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The literal Fn::Select key/index is invalid."
msgstr "La clave/índice literal Fn::Select es inválida."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The value cannot be converted to an Integer, a valid slice, or the key "
"required by the collection."
msgstr ""
"El valor no se puede convertir en un Integer, una rebanada válida o la "
"clave requerida por la colección."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The second Fn::Select argument is definitively {}, which cannot be used "
"as a collection."
msgstr ""
"El segundo argumento Fn::Select es definitivamente {}, que no se puede "
"utilizar como colección."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This argument must be List, Map, Null, EmptyString, or a String that "
"decodes to JSON List/Map/Null."
msgstr ""
"Este argumento debe ser List, Map, Null, EmptyString, o un String que "
"decodifica a JSON List/Map/Null."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Make the second argument return an actual collection, or remove "
"Fn::Select."
msgstr ""
"Hacer que el segundo argumento devuelva una colección real, o eliminar "
"Fn::Select."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The first two Fn::MemberListToMap arguments must be raw Strings."
msgstr "Los dos primeros argumentos Fn::MemberListToMap deben ser Strings crudos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The name and value field names are consumed during construction."
msgstr ""
"Los nombres de campo de nombre y valor se consumen durante la "
"construcción."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::MemberListToMap members must be Strings."
msgstr "Los miembros de Fn::MemberListToMap deben ser Strings."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime calls split('=', 1) for every item."
msgstr "El runtime llama a split('=', 1) para cada elemento."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MemberListToMap member is missing an equals sign."
msgstr "Un miembro de Fn::MemberListToMap falta un signo igual."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The member cannot be converted to the key/value pair required by dict()."
msgstr ""
"El miembro no puede ser convertido en el par clave/valor requerido por "
"dict()."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::GetJsonValue has an invalid JSON String."
msgstr "Fn::GetJsonValue tiene un JSON String inválido."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The second argument cannot be decoded as a JSON object."
msgstr "El segundo argumento no puede decodificarse como un objeto JSON."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The value selected by Fn::GetJsonValue cannot be JSON-serialized."
msgstr "El valor seleccionado por Fn::GetJsonValue no puede ser JSON-serializado."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Only the selected non-String cell enters json.dumps."
msgstr "Sólo la célula no-String seleccionada entra en json.dumps."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MergeMapToList Map contains more than one valid key/value pair."
msgstr "Un Fn::MergeMapToList Map contiene más de un par de clave/valor válido."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The locked runtime rejects this Map before the second non-empty value."
msgstr "El runtime bloqueado rechaza este Map antes del segundo valor no vacío."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "An Fn::MergeMapToList Map value must be List or Null."
msgstr "Un valor Fn::MergeMapToList Map debe ser List o Null."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Null is treated as ['']; other types fail deterministically at runtime."
msgstr ""
"Null es tratado como ['']; otros tipos fallan determinísticamente en "
"runtime."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::SelectMapList key must be hashable."
msgstr "La llave Fn::SelectMapList debe ser apresurada."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime evaluates `key in map_item`; a List/Map key fails "
"deterministically."
msgstr ""
"El runtime evalúa `key in map_item`; una clave List/Map falla "
"determinísticamente."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::SelectMapList collection members must be Maps or Null."
msgstr "Los miembros de la colección Fn::SelectMapList deben ser Maps o Null."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Null is skipped; other types cannot participate in key lookup."
msgstr "Null se salta; otros tipos no pueden participar en la búsqueda clave."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Jq method must be First or All."
msgstr "El método de Fn::Jq debe ser First o All."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "method is checked during raw construction."
msgstr "método se comprueba durante la construcción cruda."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Jq forbids $ENV in a raw script."
msgstr "Fn::Jq prohíbe $ENV en un script crudo."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"This regular-expression check occurs before function evaluation; the "
"result of a dynamic script is not checked here."
msgstr ""
"Este cheque de expresión regular ocurre antes de la evaluación de la "
"función; el resultado de un script dinámico no se revisa aquí."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Jq has a non-empty String value that is not valid JSON."
msgstr "Fn::Jq tiene un valor String no vacío que no es válido JSON."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime calls json.loads before executing jq."
msgstr "El runtime llama a json.loads antes de ejecutar jq."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Jq value cannot be JSON-serialized."
msgstr "El valor Fn::Jq no puede ser JSON-serializado."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"A value that is not short-circuited crosses the JSON boundary before the "
"jq backend."
msgstr ""
"Un valor que no es cortocircuito cruza el límite JSON antes del backend "
"jq."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::EachMemberIn List exceeds 10,000 items."
msgstr "El Fn::EachMemberIn List supera 10.000 artículos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime limits each collection to 10,000 items."
msgstr "El runtime limita cada colección a 10.000 artículos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"All Fn::Add arguments must be Numbers, Lists, or Maps of the same "
"category."
msgstr ""
"Todos los argumentos Fn::Add deben ser Numbers, Lists o Maps de la misma "
"categoría."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The three operation branches cannot be mixed."
msgstr "Las tres ramas de operación no pueden mezclarse."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Member {} of Fn::Avg cannot be converted to Float."
msgstr "El miembro {} de Fn::Avg no se puede convertir en Float."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The conversion result is {}."
msgstr "El resultado de la conversión es {}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The known Fn::Avg arguments fail during summation or rounding."
msgstr "Los argumentos conocidos de Fn::Avg fallan durante la suma o redondeo."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS runtime cannot evaluate this literal numeric combination."
msgstr "El ROS runtime no puede evaluar esta combinación numérica literal."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The non-finite Fn::Avg result cannot be converted to Integer."
msgstr "El resultado no definitivo de Fn::Avg no se puede convertir en Integer."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"When ndigits is at most 0, the runtime eventually calls int(); "
"NaN/Infinity fails deterministically."
msgstr ""
"Cuando ndigits está en la mayoría de 0, el runtime eventualmente llama "
"int(); NaN/Infinity falla determinísticamente."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Calculate expression is outside the safe allowlist."
msgstr "La expresión Fn::Calculate está fuera de la lista segura."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The expression must be a raw String; ** and non-arithmetic characters are"
" forbidden."
msgstr ""
"La expresión debe ser un String crudo; ** y los caracteres no-aritméticos"
" están prohibidos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Calculate has an invalid placeholder format."
msgstr "Fn::Calculate tiene un formato de marcador de posición inválido."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Only positional placeholders such as {0} and {1}, without conversions or "
"format specs, are allowed."
msgstr ""
"Solo se admiten titulares de posición como {0} y {1}, sin conversiones ni"
" espectros de formato."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Fn::Calculate number {} failed preflight validation."
msgstr "Fn::Calculate número {} falló la validación previa al vuelo."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "float() produced {}; preflight runs before placeholder reachability."
msgstr ""
"float() produjo {}; preflight corre antes de la alcanzabilidad del "
"marcador de posición."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Calculate references a number placeholder that does not exist."
msgstr "Fn::Calculate hace referencia a un titular número que no existe."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The maximum expression index is {}, but only {} numbers were provided."
msgstr ""
"El índice de máxima expresión es {}, pero sólo se proporcionaron números "
"{}."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Fn::Calculate expression cannot be formatted with the raw numbers."
msgstr "La expresión Fn::Calculate no puede ser formateada con los números brutos."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime calls expression.format(*numbers) before arithmetic "
"evaluation."
msgstr ""
"El runtime llama a expression.format(*numbers) antes de la evaluación "
