{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iac-code.local/schemas/resource-link-e2e-query-replay-v1.json",
  "title": "Direct query source replay registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "catalogRevisionDigest", "sourceReport", "checkpoint", "counts", "entries"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "catalogRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceReport": {
      "type": "object", "additionalProperties": false, "required": ["path", "schemaVersion", "runId"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "schemaVersion": {"const": 2},
        "runId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["path", "runId"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["contracts", "sourcePassed", "sourceBlocked", "pendingBrowser"],
      "properties": {
        "contracts": {"type": "integer", "minimum": 0},
        "sourcePassed": {"type": "integer", "minimum": 0},
        "sourceBlocked": {"type": "integer", "minimum": 0},
        "pendingBrowser": {"type": "integer", "minimum": 0}
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "contractId", "resourceType", "product", "action", "eventStatus", "sampleLevel",
          "actualApiCalled", "sourceChainStatus", "liveDestinationStatus", "cleanupStatus",
          "failureReason", "sourceEvidence", "sourceEvidenceDigest"
        ],
        "properties": {
          "contractId": {"type": "string", "minLength": 1},
          "resourceType": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "eventStatus": {"type": "string", "minLength": 1},
          "sampleLevel": {"enum": ["L0", "L1", "L2", "L3"]},
          "actualApiCalled": {"type": "boolean"},
          "sourceChainStatus": {"enum": ["pending", "blocked", "passed"]},
          "liveDestinationStatus": {"const": "pending"},
          "cleanupStatus": {"const": "not_applicable"},
          "failureReason": {"type": ["string", "null"]},
          "sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sourceEvidence": {
            "type": "object", "additionalProperties": false,
            "required": [
              "reportDigest", "checkpointDigest", "scannedRegions", "sampleDigest",
              "sampleIdentifierDigest", "sampleRegionId"
            ],
            "properties": {
              "reportDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "checkpointDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "scannedRegions": {"type": ["integer", "null"], "minimum": 0},
              "sampleDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "sampleIdentifierDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "sampleRegionId": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
