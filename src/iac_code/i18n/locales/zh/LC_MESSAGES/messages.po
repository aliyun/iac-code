msgstr "Macro/Eval 必须有 Value 且不能有 Properties。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "DataSource Local {} has an invalid Value/Properties combination."
msgstr "DataSource Local {} 的 Value/Properties 组合无效。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A DATASOURCE::* Local cannot have Value, and Properties must be a Mapping."
msgstr "DATASOURCE::* Local 禁止 Value，Properties 必须是 Mapping。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Local {} Type {} is unsupported."
msgstr "Local {} 的 Type {} 不受支持。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Macro, Eval, and DATASOURCE::* Resource Type are supported."
msgstr "支持 Macro、Eval 和 DATASOURCE::* Resource Type。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Eval Local {} uses ALIYUN::StackId in a restricted position."
msgstr "Eval Local {} 在受限位置使用了 ALIYUN::StackId。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked Locals precompiler rejects this Ref when it appears as a "
"Mapping value; use Macro instead."
msgstr "锁定 Locals 预编译器会拒绝作为 Mapping value 出现的该 Ref；可改用 Macro。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Local name {} does not match the official alphanumeric format."
msgstr "Local 名称 {} 不符合官方字母数字格式。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime accepts this name, but the official contract allows "
"only ASCII letters and digits."
msgstr "锁定 runtime 可接受该名称，但官方合同只声明英文字母和数字。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"When the outer template uses Locals, an inline nested stack cannot also "
"declare Locals."
msgstr "外层使用 Locals 时，inline 嵌套栈不能再声明 Locals。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked PreCompilerLocals scans ALIYUN::ROS::Stack.TemplateBody and "
"rejects this structure."
msgstr "锁定 PreCompilerLocals 会扫描 ALIYUN::ROS::Stack.TemplateBody 并拒绝该结构。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"An inline nested stack declares Locals, which are not officially "
"supported."
msgstr "inline 嵌套栈声明了官方不支持的 Locals。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked precompiler returns early when the outer template has no "
"Locals, but the official nested-stack contract still does not support "
"Locals."
msgstr "外层没有 Locals 时锁定预编译器会提前返回，但官方嵌套栈合同仍不支持 Locals。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Whether the remote nested stack contains Locals cannot be verified "
"locally."
msgstr "无法在本地确认远程嵌套栈是否包含 Locals。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The TemplateURL content is not in the current TemplateBody; local "
"validation does not access the network to retrieve it."
msgstr "TemplateURL 内容不在当前 TemplateBody 中；本地校验不会访问网络获取它。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Locals contain a cycle: {}."
msgstr "Locals 存在循环引用：{}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Local dependencies must be acyclic, with a reference depth no greater "
"than 5."
msgstr "Local 依赖必须无环且引用深度不超过 5。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Local {} has a reference depth greater than 5."
msgstr "Local {} 的引用深度超过 5。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS Local precompiler supports at most five reference levels."
msgstr "ROS Local 预编译最多支持五层引用。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "conflicting declaration"
msgstr "冲突声明"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Symbol {} is declared in multiple sections."
msgstr "符号 {} 在多个 section 中重复声明。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Logical names in Parameters, Resources, and Locals must be mutually "
"unique: {}."
msgstr "Parameters、Resources 和 Locals 的逻辑名必须两两唯一：{}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Rename one declaration and update its references."
msgstr "重命名其中一个声明并更新引用。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Resource {} Count is not a non-negative integer."
msgstr "资源 {} 的 Count 不是非负整数。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Count accepts an Integer, a String accepted by int(), or a dynamic "
"expression returning either value; the current type is deterministically "
"incompatible."
msgstr "Count 接受 Integer、可由 int() 解析的 String，或返回这些值的动态表达式；当前类型确定不兼容。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Resource {} Count uses a String value."
msgstr "资源 {} 的 Count 使用了 String 值。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime accepts a convertible String through int(); STRICT "
"mode recommends using Number/Integer directly."
msgstr "锁定 runtime 会通过 int() 接受可转换的 String；STRICT 模式建议直接使用 Number/Integer。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Change Count to an unquoted non-negative integer."
msgstr "将 Count 改为不带引号的非负整数。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Dynamic Count may conflict with explicit resource {}."
msgstr "动态 Count 可能与显式资源 {} 冲突。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"Count length is unknown locally; instance-name collisions can be "
"determined only after deployment parameters are known."
msgstr "Count 长度在本地未知，只有部署参数确定后才能判断实例名是否碰撞。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Expanded Count name {} conflicts with an explicit resource."
msgstr "Count 展开名称 {} 与显式资源冲突。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Full precompilation would generate a resource instance with the same name."
msgstr "完整预编译会生成同名资源实例。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Rule Assert is known to be false."
msgstr "Rule 的 Assert 已确定为 false。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This assertion will cause template validation to fail{}."
msgstr "该断言会使模板校验失败{}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Correct the Parameter default, RuleCondition, or Assert expression."
msgstr "修正参数默认值、RuleCondition 或 Assert 表达式。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Rules.{} returns {}; explicitly returning Boolean is recommended."
msgstr "Rules.{} 返回 {}，建议显式返回 Boolean。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The runtime uses truthiness for RuleCondition and fails Assert only when "
"its result is exactly False; this is retained as a compatibility "
"extension."
msgstr ""
"runtime 对 RuleCondition 使用 truthiness，对 Assert 仅在结果 is False "
"时失败；该行为保留为兼容扩展。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "A nonexistent Condition {} is referenced."
msgstr "引用了不存在的 Condition {}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The Condition name must be declared in the Conditions section."
msgstr "Condition 名必须在 Conditions section 中声明。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The ROS template exceeds the local semantic-analysis budget."
msgstr "ROS 模板超过本地语义分析预算。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Incomplete analysis has stopped and the API call has been blocked."
msgstr "已停止不完整分析并阻断 API。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "ROS function nesting exceeds 20 levels."
msgstr "ROS 函数嵌套深度超过 20。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "ROS does not accept a function at level 21."
msgstr "第 21 层函数不会被 ROS 接受。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Expression type {} is incompatible with its consumer position."
msgstr "表达式类型 {} 与消费位置不兼容。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This position requires {}."
msgstr "该位置需要 {}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Unknown ROS function {}."
msgstr "未知的 ROS 函数 {}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "This name is not in the registry of 43 ROS 2015-09-01 runtime functions."
msgstr "该名称不在 ROS 2015-09-01 的 43 个运行时函数注册表中。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Check the function name."
msgstr "检查函数拼写。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Function {} cannot be used in {} context."
msgstr "函数 {} 不能用于 {} 上下文。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"ROS registers different function tables for normal expressions, "
"Conditions/Rules, and Count."
msgstr "ROS 为普通表达式、Conditions/Rules 和 Count 注册了不同的函数表。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "A Module registration template cannot use Fn::GetStackOutput."
msgstr "Module 注册模板不能使用 Fn::GetStackOutput。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Module registration cannot depend on the runtime output of another Stack."
msgstr "Module 注册阶段不能依赖另一个 Stack 的运行时输出。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Fn::Select cannot select an element during Count precompilation."
msgstr "Count 预编译阶段的 Fn::Select 无法选择元素。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The known arguments of {} cannot be evaluated under the ROS runtime "
"contract."
msgstr "{} 的已知参数无法按 ROS runtime 合同求值。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"Local precomputation failed at the {} boundary; the remaining independent"
" expressions will still be validated."
msgstr "本地预计算在 {} 边界失败；其余独立表达式仍会继续校验。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} has an invalid argument shape."
msgstr "{} 的参数形状无效。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The runtime requires {}."
msgstr "运行时需要 {}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} argument {} has incompatible type {}."
msgstr "{} 第 {} 个参数的类型 {} 不兼容。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "This argument requires {}."
msgstr "该参数需要 {}。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} argument {} uses Boolean as Integer."
msgstr "{} 第 {} 个参数把 Boolean 用作 Integer。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The ROS Python runtime accepts this value, but an explicit Integer is "
"clearer and better matches the official template contract."
msgstr "ROS 的 Python runtime 会接受该值，但显式 Integer 更清晰且更符合官方模板合同。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "The known result of {} is a non-finite Number."
msgstr "{} 的已知结果是非有限 Number。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked runtime returns NaN/Infinity, but that value violates standard"
" JSON and the official template numeric constraints."
msgstr "锁定 runtime 会返回 NaN/Infinity，但该值偏离标准 JSON 和官方模板数值约束。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} List members must be hashable."
msgstr "{} 的 List 成员必须可哈希。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "The runtime checks each item for hashability before comparing collections."
msgstr "runtime 在集合比较前逐项执行 hashability 检查。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} uses a runtime-only non-List Iterable outer container."
msgstr "{} 使用了 runtime-only 的非 List Iterable 外层。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The locked constructor unpacks by iteration order; the official template "
"contract recommends a List."
msgstr "锁定构造器会按迭代顺序解包；官方模板合同建议使用 List。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "{} uses a runtime-only indexable Mapping outer container."
msgstr "{} 使用了 runtime-only 的 indexable Mapping 外层。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid ""
"The locked implementation indexes this container from 0 through {}; the "
"official template contract recommends a List."
msgstr "锁定实现按 0..{} 索引该容器；官方模板建议使用 List。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "Function-form Ref resolves to {}, which is not a visible Parameter."
msgstr "函数形式 Ref 的结果 {} 不是可见 Parameter。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid ""
"The Ref factory selects ParamRef before function evaluation; it does not "
"switch to ResourceRef when the result is a resource name."
msgstr "Ref factory 在函数求值前已选择 ParamRef，不会因结果是资源名而改选 ResourceRef。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
