#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} is not an allowed "
"value."
msgstr "Alibaba Cloud API {operation} のパラメーター {parameter} は許可された値ではありません。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameter {parameter}."
msgstr "Alibaba Cloud API {operation} にパスパラメーター {parameter} がありません。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameters {parameters}."
msgstr "Alibaba Cloud API {operation} にパスパラメーター {parameters} がありません。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API path parameters are invalid or incomplete for "
"{operation}."
msgstr "Alibaba Cloud API {operation} のパスパラメーターが無効または不完全です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} path parameter {parameter} expects "
"{expected} but received {actual}."
msgstr ""
"Alibaba Cloud API {operation} のパスパラメーター {parameter} には {expected} "
"が必要ですが、{actual} を受け取りました。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a scalar "
"header value without line breaks but received {actual}."
msgstr ""
"Alibaba Cloud API {operation} のパラメーター {parameter} "
"には改行を含まない単一のヘッダー値が必要ですが、{actual} を受け取りました。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid "
"header name but received a {actual} with invalid syntax."
msgstr ""
"Alibaba Cloud API {operation} のパラメーター {parameter} には有効なヘッダー名が必要ですが、構文が無効な"
" {actual} を受け取りました。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid DNS "
"host-label string but received {actual} with invalid syntax."
msgstr ""
"Alibaba Cloud API {operation} のパラメーター {parameter} には有効な DNS "
"ホストラベル文字列が必要ですが、構文が無効な {actual} を受け取りました。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} targets a reserved "
"authentication header. Remove the parameter and retry."
msgstr ""
"Alibaba Cloud API {operation} のパラメーター {parameter} "
"は予約済みの認証ヘッダーを対象としています。このパラメーターを削除して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} uses a protocol shape this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"Alibaba Cloud API {operation} は、このランタイムで実行できないプロトコル形式を使用しています。別の API "
"バージョンまたはアクションを選択してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} metadata uses a schema this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"Alibaba Cloud API {operation} のメタデータは、このランタイムで実行できないスキーマを使用しています。別の API "
"バージョンまたはアクションを選択してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud OSS API {operation} is not supported by this runtime. "
"Choose a supported OSS action or use another client."
msgstr ""
"このランタイムは Alibaba Cloud OSS API {operation} をサポートしていません。サポートされる OSS "
"アクションを選択するか、別のクライアントを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} cannot be executed from its current "
"metadata. Choose another API version or action."
msgstr ""
"現在のメタデータでは Alibaba Cloud API {operation} を実行できません。別の API "
"バージョンまたはアクションを選択してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud endpoint cache could not be updated for {operation} in "
"{region}. Check local configuration storage and retry."
msgstr ""
"{region} の {operation} に対する Alibaba Cloud "
"エンドポイントキャッシュを更新できませんでした。ローカル設定ストレージを確認して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No trusted Alibaba Cloud endpoint is available for {operation} in "
"{region}. Check the region or endpoint configuration."
msgstr ""
"{region} の {operation} に使用できる信頼済み Alibaba Cloud "
"エンドポイントがありません。リージョンまたはエンドポイント設定を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud host parameters are invalid for {operation} in {region}."
msgstr "{region} の {operation} に対する Alibaba Cloud ホストパラメーターが無効です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud authentication is unsupported for {operation}. Check the "
"API contract or choose an API that supports AccessKey authentication."
msgstr ""
"{operation} では Alibaba Cloud 認証がサポートされていません。API コントラクトを確認するか、AccessKey "
"認証をサポートする API を選択してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud credentials are unavailable. Configure credentials and "
"retry {operation}."
msgstr "Alibaba Cloud の認証情報を利用できません。認証情報を設定して {operation} を再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} is reserved for "
"request signing and cannot be set."
msgstr ""
"Alibaba Cloud API {operation} のパラメーター {parameter} "
"はリクエスト署名用に予約されているため、設定できません。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud signing is unsupported for {operation}. Check the API "
"contract."
msgstr "{operation} では Alibaba Cloud 署名がサポートされていません。API コントラクトを確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API execution is unavailable for {operation}. Retry from an"
" active runtime."
msgstr "Alibaba Cloud API {operation} を実行できません。アクティブなランタイムから再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API authorization expired or changed. Run {operation} again"
" to approve the current contract."
msgstr ""
"Alibaba Cloud API の認可が期限切れになったか変更されました。{operation} "
"を再度実行して現在のコントラクトを承認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} does not accept body_file. Use the body "
"source declared by the API contract."
msgstr ""
"Alibaba Cloud API {operation} は body_file を受け付けません。API "
"コントラクトで宣言されたボディソースを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body_file exceeds the 32 MiB limit. Use a "
"smaller regular file."
msgstr ""
"Alibaba Cloud API {operation} の body_file が 32 MiB "
"の上限を超えています。より小さい通常ファイルを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} requires a body source compatible with its "
"API contract."
msgstr "Alibaba Cloud API {operation} には、その API コントラクトと互換性のあるボディソースが必要です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received multiple body sources. Provide "
"only one of body, body_file, or body parameters."
msgstr ""
"Alibaba Cloud API {operation} に複数のボディソースが指定されています。body、body_file、body "
"パラメーターのいずれか 1 つだけを指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received multiple template sources. Provide"
" only one."
msgstr "Alibaba Cloud API {operation} に複数のテンプレートソースが指定されています。1 つだけ指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} content_type does not match the request "
"body. Use a compatible media type."
msgstr ""
"Alibaba Cloud API {operation} の content_type "
"がリクエストボディと一致しません。互換性のあるメディアタイプを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} has content_type without a request body. "
"Remove content_type or provide a body."
msgstr ""
"Alibaba Cloud API {operation} にリクエストボディなしで content_type "
"が指定されています。content_type を削除するか、ボディを指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body is invalid. Provide a valid JSON or "
"form request body."
msgstr ""
"Alibaba Cloud API {operation} のボディが無効です。有効な JSON "
"またはフォームのリクエストボディを指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body_file is invalid. Use a readable "
"regular file within the allowed size."
msgstr ""
"Alibaba Cloud API {operation} の body_file "
"が無効です。許可されたサイズ内の読み取り可能な通常ファイルを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} content_type is invalid. Use a valid media "
"type such as application/json."
msgstr ""
"Alibaba Cloud API {operation} の content_type が無効です。application/json "
"などの有効なメディアタイプを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} template file is invalid. Use a readable "
"regular template file."
msgstr ""
"Alibaba Cloud API {operation} "
"のテンプレートファイルが無効です。読み取り可能な通常のテンプレートファイルを使用してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} template validation failed. Check the "
"template syntax and resource definitions."
msgstr "Alibaba Cloud API {operation} のテンプレート検証に失敗しました。テンプレート構文とリソース定義を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} max_response_bytes must be between 1 and "
"16777216."
msgstr ""
"Alibaba Cloud API {operation} の max_response_bytes は 1 から 16777216 "
"の範囲で指定してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned HTTP {status} with error code "
"{code}. Check the request and cloud permissions before retrying."
msgstr ""
"Alibaba Cloud API {operation} が HTTP {status}、エラーコード {code} "
"を返しました。再試行する前にリクエストとクラウド権限を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned HTTP {status}. Check the request "
"and cloud permissions before retrying."
msgstr ""
"Alibaba Cloud API {operation} が HTTP {status} "
"を返しました。再試行する前にリクエストとクラウド権限を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} could not connect before the request was "
"sent. Check network and endpoint access, then retry."
msgstr ""
"Alibaba Cloud API {operation} "
"はリクエスト送信前に接続できませんでした。ネットワークとエンドポイントへのアクセスを確認して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received a retryable service response, but "
"the retry deadline expired. Retry the read-only request later."
msgstr ""
"Alibaba Cloud API {operation} "
"は再試行可能なサービスレスポンスを受け取りましたが、再試行期限が切れました。後で読み取り専用リクエストを再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} read-only request did not complete before "
"the retry deadline. Check network and service health, then retry."
msgstr ""
"Alibaba Cloud API {operation} "
"の読み取り専用リクエストは再試行期限までに完了しませんでした。ネットワークとサービスの状態を確認して再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} timed out after the request may have been "
"sent. Check cloud state before retrying to avoid duplicate changes."
msgstr ""
"Alibaba Cloud API {operation} "
"はリクエスト送信後にタイムアウトした可能性があります。変更の重複を避けるため、再試行前にクラウドの状態を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} timed out before the request was sent. "
"Retry the operation."
msgstr "Alibaba Cloud API {operation} はリクエスト送信前にタイムアウトしました。操作を再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} returned an invalid response after the "
"request was sent. Check cloud state before retrying to avoid duplicate "
"changes."
msgstr ""
"Alibaba Cloud API {operation} "
"はリクエスト送信後に無効なレスポンスを返しました。変更の重複を避けるため、再試行前にクラウドの状態を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} may have been sent before the connection "
"failed. Check cloud state before retrying to avoid duplicate changes."
msgstr ""
"Alibaba Cloud API {operation} "
"は接続失敗前に送信された可能性があります。変更の重複を避けるため、再試行前にクラウドの状態を確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} response exceeded max_response_bytes. "
"Increase the limit or narrow the request and retry."
msgstr ""
"Alibaba Cloud API {operation} のレスポンスが max_response_bytes "
"を超えました。上限を増やすか、リクエスト範囲を狭めて再試行してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} error response exceeded the 1 MiB safety "
"limit. Check Alibaba Cloud logs before retrying."
msgstr ""
"Alibaba Cloud API {operation} のエラーレスポンスが 1 MiB の安全上限を超えました。再試行前に Alibaba "
"Cloud のログを確認してください。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API parameters are invalid for {operation}."
msgstr "{operation} の Alibaba Cloud API パラメーターが無効です。"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} could not be prepared safely. Check the "
"request and try again."
msgstr "Alibaba Cloud API {operation} を安全に準備できませんでした。リクエストを確認して再試行してください。"

