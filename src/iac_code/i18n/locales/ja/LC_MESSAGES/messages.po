msgstr "{template_url} の ROS テンプレートツールを呼び出しています..."

#: src/iac_code/tools/cloud/aliyun/template_source.py
#, python-brace-format
msgid ""
"ROS pipeline calls for {action} must use the dedicated {tool_name} tool "
"instead of aliyun_api. Do not call the raw ROS template API directly."
msgstr ""
"{action} の ROS パイプライン呼び出しでは、aliyun_api ではなく専用ツール {tool_name} "
"を使用する必要があります。生の ROS テンプレート API を直接呼び出さないでください。"

#: src/iac_code/tools/cloud/aliyun/template_source.py
#, python-brace-format
msgid ""
"ROS pipeline calls for {action} must use the dedicated ros_deploy tool "
"instead of aliyun_api. Do not call the raw ROS deployment API directly."
msgstr ""
"{action} の ROS パイプライン呼び出しでは、aliyun_api ではなく専用の ros_deploy "
"ツールを使用する必要があります。生の ROS デプロイ API を直接呼び出さないでください。"

#: src/iac_code/tools/cloud/aliyun/template_source.py
msgid ""
"ROS template calls must use TemplateURL instead of TemplateBody. Save the"
" template to a file and pass params.TemplateURL, for example a local file"
" path or OSS/HTTP URL."
msgstr ""
"ROS テンプレート呼び出しでは TemplateBody ではなく TemplateURL "
"を使用する必要があります。テンプレートをファイルに保存し、ローカルファイルパスまたは OSS/HTTP URL などを "
"params.TemplateURL として渡してください。"

#: src/iac_code/tools/cloud/aliyun/template_source.py
#, python-brace-format
msgid ""
"ROS pipeline calls for {action} must pass params.TemplateURL. Save the "
"template to a file and pass params.TemplateURL, for example a local file "
"path or OSS/HTTP URL."
msgstr ""
"ROS パイプラインで {action} を呼び出す場合は、params.TemplateURL "
"を渡す必要があります。テンプレートをファイルに保存し、ローカルファイルパスまたは OSS/HTTP URL などを "
"params.TemplateURL として渡してください。"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "The local ROS template file cannot be read."
msgstr "ローカルROSテンプレートファイルは読みません。"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "The local ROS template file is not valid UTF-8."
msgstr "ローカルROSテンプレートファイルはUTF-8では有効ではありません。"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid ""
"TemplateURL/local TemplateBody failed before entering the Parser; the ROS"
" API was not called."
msgstr "TemplateURL/local TemplateBodyは、パーサを入力する前に失敗しました。 ROS APIは呼びませんでした。"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "Confirm that the file exists, is readable, and is saved as UTF-8."
msgstr "ファイルが読みやすく、UTF-8として保存されていることを確認してください。"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template YAML syntax error: {}"
msgstr "テンプレートの YAML 構文エラー: {}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template YAML syntax error (line {line}, column {col}): {problem}"
msgstr "テンプレートYAMLの構文エラー({line}、列{col}):{problem}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
#, python-brace-format
msgid "Template JSON syntax error (line {line}, column {col}): {msg}"
msgstr "テンプレートの JSON 構文エラー（{line} 行目、{col} 列目）: {msg}"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid "Template parse failed"
msgstr "テンプレートパース失敗"

#: src/iac_code/tools/cloud/aliyun/hooks/ros_validate.py
msgid ""
"Template parse result is not an object (dict), please check the template "
"format"
msgstr "テンプレート解析結果はオブジェクト(dict)ではなく、テンプレートの形式を確認してください。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Trusted ROS account context is missing, so the Module registration "
"account boundary cannot be verified."
msgstr "ROSアカウントのコンテキストが不足しているため、Module登録アカウントの境界は検証できません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Local structure and function semantics were validated; account "
"consistency requires trusted host context."
msgstr "Local構造と機能のセマティクスが検証されました。アカウントの一貫性は信頼できるホストコンテキストを必要とします。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "PreviewStack has an invalid number of template sources."
msgstr "PreviewStackは、テンプレートソースの無効な数を持っています。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Creating a preview requires one source; updating a preview accepts zero "
"or one source."
msgstr "プレビューを作成するには、1つのソースが必要です。プレビューを更新すると、ゼロまたは1つのソースが受け入れられます。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "PreviewStack must provide Parameters when reusing the existing template."
msgstr "PreviewStackは、既存のテンプレートを再利用する際にParametersを提供する必要があります。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"A source-less update preview reuses the template only when Parameters is "
"provided."
msgstr "ソースレスアップデートプレビューでは、Parametersが提供されているときにのみテンプレートを再利用します。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ContinueCreateStack.Mode is invalid."
msgstr "ContinueCreateStack.Mode は無効です。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "Mode must be Recreate or Ignore."
msgstr "Mode は Recreate または Ignore である必要があります。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ContinueCreateStack provides multiple template sources."
msgstr "ContinueCreateStackは複数のテンプレートソースを提供します。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "Recreate accepts at most one source."
msgstr "Recreate が受け付ける source は最大 1 つです。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The CreateChangeSet template source does not match ChangeSetType."
msgstr "CreateChangeSetテンプレートソースはChangeSetTypeと一致しません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Select one of Body, URL, or TemplateId; ScratchId is valid only for "
"IMPORT of a new stack."
msgstr "ボディ、URL、またはTemplateIdのいずれかを選択します。ScratchIdは、新しいスタックのIMPORTのみ有効です。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "GetTemplateRecommendParameters has an invalid template source."
msgstr "GetTemplateRecommendParameters は無効なテンプレートソースを持っています。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Provide at least one source, and do not provide TemplateBody and "
"TemplateURL together."
msgstr "少なくとも1つのソースを提供し、TemplateBodyおよびTemplateURLを一緒に提供しません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"GetTemplateRecommendParameters provides TemplateId together with a "
"higher-priority source."
msgstr "GetTemplateRecommendParameters は、TemplateId を、より優れたソースで提供しています。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"ROS prefers TemplateBody/TemplateURL, so TemplateId is ignored in this "
"call."
msgstr "ROSはTemplateBody/TemplateURLを好むので、TemplateIdはこの呼び出しで無視されます。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "ListStackOperationRisks.OperationType is invalid."
msgstr "ListStackOperationRisks.OperationTypeは無効です。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The locked SDK declares only CreateStack and DeleteStack."
msgstr "ロックされたSDKはCreateStackおよびDeleteStackだけを宣言します。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The ListStackOperationRisks source does not match OperationType."
msgstr "ListStackOperationRisksソースはOperationTypeと一致しません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"CreateStack requires one template source; DeleteStack accepts only "
"StackId."
msgstr "CreateStackは1つのテンプレートソースが必要です。DeleteStackはStackIdだけを受け入れます。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "CreateStackGroup cannot provide Parameters when StackArn is used."
msgstr "CreateStackGroupはStackArnが使用されるときParametersを提供できません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"StackArn references an existing stack template, so Parameters is "
"ineffective in this branch."
msgstr "StackArnは既存のスタックテンプレートを参照しているため、Parametersはこのブランチで無効です。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "CreateStackGroup must use SELF_MANAGED when StackArn is used."
msgstr "CreateStackGroupはStackArnが使用されるときSELF_MANAGEDを使用する必要があります。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The SERVICE_MANAGED branch does not accept StackArn as a template source."
msgstr "SERVICE_MANAGEDブランチはStackArnをテンプレートソースとして受け入れません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"Local template analysis for RegisterResourceType supports only "
"EntityType=Module."
msgstr "RegisterResourceType用のLocalテンプレート解析は、EntityType=Moduleのみに対応しています。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "EntityType is not Module."
msgstr "EntityTypeはModuleではありません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "RegisterResourceType.ResourceType has an invalid format."
msgstr "RegisterResourceType.ResourceTypeは無効なフォーマットを持っています。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"It must contain 18 to 100 characters and match "
"MODULE::Organization::Service::Type."
msgstr "MODULE::Organization::Service::Type にマッチする文字は 18 文字から 100 文字を含んだ必要があります。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The service segment of MODULE::SHARE does not match the current tenant."
msgstr "MODULE::SHAREのサービスセグメントは、現在のテナントと一致しません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid ""
"The third segment of a SHARE Module must equal tenant_id in the trusted "
"account context."
msgstr "SHARE Moduleの3番目のセグメントは、信頼できるアカウントのコンテキストでtenant_idを等しくしなければなりません。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
#, python-brace-format
msgid "contains {}"
msgstr "{}を含んでいます"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "starts with acs"
msgstr "acsから始まる"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
#, python-brace-format
msgid "equals reserved name {}"
msgstr "等しい予約名 {}"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
msgid "The Module organization uses a name reserved for non-production accounts."
msgstr "Module 組織は、非生成アカウントで予約された名前を使用します。"

#: src/iac_code/tools/cloud/aliyun/ros_validation/action_policy.py
