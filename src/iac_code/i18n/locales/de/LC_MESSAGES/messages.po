#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud product must contain only letters, numbers, underscores, or"
" hyphens."
msgstr ""
"Das Alibaba-Cloud-Produkt darf nur Buchstaben, Zahlen, Unterstriche oder "
"Bindestriche enthalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud API action must contain only letters, numbers, underscores,"
" or hyphens."
msgstr ""
"Die Alibaba-Cloud-API-Aktion darf nur Buchstaben, Zahlen, Unterstriche "
"oder Bindestriche enthalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "Alibaba Cloud API version contains unsupported characters."
msgstr "Die Alibaba-Cloud-API-Version enthält nicht unterstützte Zeichen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud region must contain only lowercase letters, numbers, or "
"hyphens."
msgstr ""
"Die Alibaba-Cloud-Region darf nur Kleinbuchstaben, Zahlen oder "
"Bindestriche enthalten."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API protocol overrides are invalid for {operation}. Remove "
"style, method, or pathname overrides and retry."
msgstr ""
"Die Protokollüberschreibungen der Alibaba-Cloud-API für {operation} sind "
"ungültig. Entfernen Sie die Überschreibungen für style, method oder "
"pathname und versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API input is invalid for {operation}. Check product, "
"action, version, region, and parameters."
msgstr ""
"Die Eingabe der Alibaba-Cloud-API für {operation} ist ungültig. Prüfen "
"Sie Produkt, Aktion, Version, Region und Parameter."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud returned the target response, but its headers are too large"
" to display safely. Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud hat die erwartete Antwort zurückgegeben, aber ihre Header "
"sind zu groß, um sicher angezeigt zu werden. Überprüfen Sie den Status "
"der Cloud-Ressource, bevor Sie es erneut versuchen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud returned an unsupported response body for {operation}. "
"Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud hat für {operation} einen nicht unterstützten Antworttext "
"zurückgegeben. Überprüfen Sie den Status der Cloud-Ressource, bevor Sie "
"es erneut versuchen."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} detail must be one of: summary, full."
msgstr "detail für die Alibaba-Cloud-API {operation} muss summary oder full sein."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud product {product} was not found. Check the product code and"
" try again."
msgstr ""
"Das Alibaba-Cloud-Produkt {product} wurde nicht gefunden. Prüfen Sie den "
"Produktcode und versuchen Sie es erneut."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
