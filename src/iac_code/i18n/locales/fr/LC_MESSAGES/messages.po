msgstr ""
"Le nom n'apparaît pas dans les paramètres Parameters, Resources, Locals "
"ou pseudo."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
msgid "Correct the logical name or add the missing declaration."
msgstr "Corriger le nom logique ou ajouter la déclaration manquante."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
#, python-brace-format
msgid "ParamRef in {} context uses a non-String parameter key."
msgstr "ParamRef dans le contexte {} utilise une clé de paramètre non-String."

#: src/iac_code/tools/cloud/aliyun/ros_validation/analyzer.py
