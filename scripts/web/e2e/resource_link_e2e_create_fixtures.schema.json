{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iac-code.local/schemas/resource-link-e2e-create-fixtures-v1.json",
  "title": "Metadata-driven create API fixture registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "catalogRevisionDigest", "provenance", "counts", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "catalogRevisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["contracts", "actualApiCalled"],
      "properties": {
        "contracts": {"type": "integer", "minimum": 0},
        "actualApiCalled": {"const": 0}
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "contractId", "resourceType", "product", "action", "responseIdentifierPath",
          "actualApiCalled", "responseProvenance", "identifierProvenance", "sampleLevel",
          "sourceChainStatus", "liveDestinationStatus", "cleanupStatus", "failureReason",
          "replayPassed", "sourceEvidenceDigest"
        ],
        "properties": {
          "contractId": {"type": "string", "minLength": 1},
          "resourceType": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "responseIdentifierPath": {"type": "string", "minLength": 1},
          "actualApiCalled": {"const": false},
          "responseProvenance": {"const": "synthetic-from-metadata"},
          "identifierProvenance": {"const": "preexisting-query"},
          "sampleLevel": {"const": "L1"},
          "sourceChainStatus": {"const": "passed"},
          "liveDestinationStatus": {"const": "pending"},
          "cleanupStatus": {"const": "not_applicable"},
          "failureReason": {"type": "null"}
          ,"replayPassed": {"const": true}
          ,"sourceEvidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
