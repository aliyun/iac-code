msgstr "l'action demandée"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "the requested region"
msgstr "la région demandée"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud product must contain only letters, numbers, underscores, or"
" hyphens."
msgstr ""
"Le produit Alibaba Cloud ne doit contenir que des lettres, des chiffres, "
"des traits de soulignement ou des traits d'union."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud API action must contain only letters, numbers, underscores,"
" or hyphens."
msgstr ""
"L'action de l'API Alibaba Cloud ne doit contenir que des lettres, des "
"chiffres, des traits de soulignement ou des traits d'union."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "Alibaba Cloud API version contains unsupported characters."
msgstr ""
"La version de l'API Alibaba Cloud contient des caractères non pris en "
"charge."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud region must contain only lowercase letters, numbers, or "
"hyphens."
msgstr ""
"La région Alibaba Cloud ne doit contenir que des lettres minuscules, des "
"chiffres ou des traits d'union."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API protocol overrides are invalid for {operation}. Remove "
"style, method, or pathname overrides and retry."
msgstr ""
"Les substitutions de protocole de l'API Alibaba Cloud ne sont pas valides"
" pour {operation}. Supprimez les substitutions de style, method ou "
"pathname, puis réessayez."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API input is invalid for {operation}. Check product, "
"action, version, region, and parameters."
msgstr ""
"L'entrée de l'API Alibaba Cloud n'est pas valide pour {operation}. "
"Vérifiez le produit, l'action, la version, la région et les paramètres."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid ""
"Alibaba Cloud returned the target response, but its headers are too large"
" to display safely. Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud a renvoyé la réponse attendue, mais ses en-têtes sont trop "
"volumineux pour être affichés en toute sécurité. Vérifiez l'état de la "
"ressource cloud avant de réessayer."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud returned an unsupported response body for {operation}. "
"Verify the cloud resource state before retrying."
msgstr ""
"Alibaba Cloud a renvoyé un corps de réponse non pris en charge pour "
"{operation}. Vérifiez l'état de la ressource cloud avant de réessayer."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} detail must be one of: summary, full."
msgstr "Le détail de l'API Alibaba Cloud {operation} doit être summary ou full."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud product {product} was not found. Check the product code and"
" try again."
msgstr ""
"Le produit Alibaba Cloud {product} est introuvable. Vérifiez le code du "
"produit et réessayez."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid " Suggested product codes: {suggestions}."
msgstr " Codes produit suggérés : {suggestions}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {product}/{version}/{action} was not found. Check the "
"product, version, and action."
msgstr ""
"L'API Alibaba Cloud {product}/{version}/{action} est introuvable. "
"Vérifiez le produit, la version et l'action."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} was not found. Check the product, version, "
"and action."
msgstr ""
"L'API Alibaba Cloud {operation} est introuvable. Vérifiez le produit, la "
"version et l'action."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API metadata for {operation} is temporarily unavailable; "
"try again later."
msgstr ""
"Les métadonnées de l'API Alibaba Cloud pour {operation} sont "
"temporairement indisponibles. Réessayez plus tard."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API metadata for {operation} returned an incompatible "
"response. Check the API identifiers or try again later."
msgstr ""
"Les métadonnées de l'API Alibaba Cloud pour {operation} ont renvoyé une "
"réponse incompatible. Vérifiez les identifiants de l'API ou réessayez "
"plus tard."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No valid Alibaba Cloud API version is available for {product}; provide an"
" explicit version."
msgstr ""
"Aucune version valide de l'API Alibaba Cloud n'est disponible pour "
"{product}. Indiquez une version explicite."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} requires body_file for its binary request "
"body."
msgstr ""
"L'API Alibaba Cloud {operation} nécessite body_file pour son corps de "
"requête binaire."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} requires parameter {parameter}."
msgstr "L'API Alibaba Cloud {operation} nécessite le paramètre {parameter}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} requires parameters {parameters}."
msgstr "L'API Alibaba Cloud {operation} nécessite les paramètres {parameters}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing required parameters."
msgstr "Des paramètres obligatoires manquent pour l'API Alibaba Cloud {operation}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
msgid "the requested parameter"
msgstr "le paramètre demandé"

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects {expected} "
"but received {actual}."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} attend "
"{expected}, mais a reçu {actual}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} is not an allowed "
"value."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} n'est pas une"
" valeur autorisée."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameter {parameter}."
msgstr ""
"Le paramètre de chemin {parameter} manque pour l'API Alibaba Cloud "
"{operation}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud API {operation} is missing path parameters {parameters}."
msgstr ""
"Les paramètres de chemin {parameters} manquent pour l'API Alibaba Cloud "
"{operation}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API path parameters are invalid or incomplete for "
"{operation}."
msgstr ""
"Les paramètres de chemin de l'API Alibaba Cloud ne sont pas valides ou "
"sont incomplets pour {operation}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} path parameter {parameter} expects "
"{expected} but received {actual}."
msgstr ""
"Le paramètre de chemin {parameter} de l'API Alibaba Cloud {operation} "
"attend {expected}, mais a reçu {actual}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a scalar "
"header value without line breaks but received {actual}."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} attend une "
"valeur d'en-tête scalaire sans saut de ligne, mais a reçu {actual}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid "
"header name but received a {actual} with invalid syntax."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} attend un nom"
" d'en-tête valide, mais a reçu {actual} avec une syntaxe non valide."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} expects a valid DNS "
"host-label string but received {actual} with invalid syntax."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} attend une "
"chaîne d'étiquette d'hôte DNS valide, mais a reçu {actual} avec une "
"syntaxe non valide."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} targets a reserved "
"authentication header. Remove the parameter and retry."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} cible un en-"
"tête d'authentification réservé. Supprimez ce paramètre et réessayez."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} uses a protocol shape this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"L'API Alibaba Cloud {operation} utilise une forme de protocole que cet "
"environnement d'exécution ne peut pas exécuter. Choisissez une autre "
"version ou action d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} metadata uses a schema this runtime cannot "
"execute. Choose another API version or action."
msgstr ""
"Les métadonnées de l'API Alibaba Cloud {operation} utilisent un schéma "
"que cet environnement d'exécution ne peut pas exécuter. Choisissez une "
"autre version ou action d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud OSS API {operation} is not supported by this runtime. "
"Choose a supported OSS action or use another client."
msgstr ""
"L'API OSS Alibaba Cloud {operation} n'est pas prise en charge par cet "
"environnement d'exécution. Choisissez une action OSS prise en charge ou "
"utilisez un autre client."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} cannot be executed from its current "
"metadata. Choose another API version or action."
msgstr ""
"L'API Alibaba Cloud {operation} ne peut pas être exécutée à partir de ses"
" métadonnées actuelles. Choisissez une autre version ou action d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud endpoint cache could not be updated for {operation} in "
"{region}. Check local configuration storage and retry."
msgstr ""
"Le cache des endpoints Alibaba Cloud n'a pas pu être mis à jour pour "
"{operation} dans {region}. Vérifiez le stockage de la configuration "
"locale et réessayez."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata service is unreachable, so "
"{operation} cannot be signed. Confirm this process runs on an ECS "
"instance with a bound RAM role."
msgstr ""
"Le service de métadonnées de l'instance ECS Alibaba Cloud est "
"inaccessible, {operation} ne peut donc pas être signée. Vérifiez que ce "
"processus s'exécute sur une instance ECS associée à un rôle RAM."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata credentials are disabled, so "
"{operation} cannot be signed. Check the "
"ALIBABA_CLOUD_ECS_METADATA_DISABLED environment variable."
msgstr ""
"Les identifiants issus des métadonnées de l'instance ECS Alibaba Cloud "
"sont désactivés, {operation} ne peut donc pas être signée. Vérifiez la "
"variable d'environnement ALIBABA_CLOUD_ECS_METADATA_DISABLED."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS metadata token (IMDSv2) could not be obtained while "
"IMDSv1 is disabled, so {operation} cannot be signed. Check the instance "
"metadata settings and network."
msgstr ""
"Le jeton de métadonnées ECS Alibaba Cloud (IMDSv2) n'a pas pu être obtenu"
" alors qu'IMDSv1 est désactivé, {operation} ne peut donc pas être signée."
" Vérifiez les paramètres de métadonnées de l'instance et le réseau."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No matching Alibaba Cloud ECS instance RAM role was found, so {operation}"
" cannot be signed. Check the instance RAM role and the configured ECS RAM"
" role name."
msgstr ""
"Aucun rôle RAM d'instance ECS Alibaba Cloud correspondant n'a été trouvé,"
" {operation} ne peut donc pas être signée. Vérifiez le rôle RAM de "
"l'instance et le nom du rôle RAM ECS configuré."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance metadata returned incomplete RAM role "
"credentials, so {operation} cannot be signed. Retry and check the ECS "
"metadata service."
msgstr ""
"Les métadonnées de l'instance ECS Alibaba Cloud ont renvoyé des "
"identifiants de rôle RAM incomplets, {operation} ne peut donc pas être "
"signée. Réessayez et vérifiez le service de métadonnées ECS."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud ECS instance RAM role credentials could not be refreshed "
"before they expired, so {operation} cannot be signed. Check ECS metadata "
"availability."
msgstr ""
"Les identifiants du rôle RAM de l'instance ECS Alibaba Cloud n'ont pas pu"
" être renouvelés avant leur expiration, {operation} ne peut donc pas être"
" signée. Vérifiez la disponibilité des métadonnées ECS."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"No trusted Alibaba Cloud endpoint is available for {operation} in "
"{region}. Check the region or endpoint configuration."
msgstr ""
"Aucun endpoint Alibaba Cloud approuvé n'est disponible pour {operation} "
"dans {region}. Vérifiez la région ou la configuration de l'endpoint."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid "Alibaba Cloud host parameters are invalid for {operation} in {region}."
msgstr ""
"Les paramètres d'hôte Alibaba Cloud ne sont pas valides pour {operation} "
"dans {region}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud authentication is unsupported for {operation}. Check the "
"API contract or choose an API that supports AccessKey authentication."
msgstr ""
"L'authentification Alibaba Cloud n'est pas prise en charge pour "
"{operation}. Vérifiez le contrat d'API ou choisissez une API prenant en "
"charge l'authentification AccessKey."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud credentials are unavailable. Configure credentials and "
"retry {operation}."
msgstr ""
"Les identifiants Alibaba Cloud ne sont pas disponibles. Configurez-les et"
" réessayez {operation}."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} parameter {parameter} is reserved for "
"request signing and cannot be set."
msgstr ""
"Le paramètre {parameter} de l'API Alibaba Cloud {operation} est réservé à"
" la signature de la requête et ne peut pas être défini."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud signing is unsupported for {operation}. Check the API "
"contract."
msgstr ""
"La signature Alibaba Cloud n'est pas prise en charge pour {operation}. "
"Vérifiez le contrat d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API execution is unavailable for {operation}. Retry from an"
" active runtime."
msgstr ""
"L'exécution de l'API Alibaba Cloud n'est pas disponible pour {operation}."
" Réessayez depuis un environnement d'exécution actif."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} cannot modify cloud resources from a "
"pipeline step. Use a pipeline-specific tool for this operation."
msgstr ""
"L’API Alibaba Cloud {operation} ne peut pas modifier des ressources cloud"
" depuis une étape du pipeline. Utilisez l’outil dédié au pipeline pour "
"cette opération."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API authorization expired or changed. Run {operation} again"
" to approve the current contract."
msgstr ""
"L'autorisation de l'API Alibaba Cloud a expiré ou a changé. Exécutez de "
"nouveau {operation} pour approuver le contrat actuel."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} does not accept body_file. Use the body "
"source declared by the API contract."
msgstr ""
"L'API Alibaba Cloud {operation} n'accepte pas body_file. Utilisez la "
"source de corps déclarée par le contrat d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} body_file exceeds the 32 MiB limit. Use a "
"smaller regular file."
msgstr ""
"Le body_file de l'API Alibaba Cloud {operation} dépasse la limite de 32 "
"MiB. Utilisez un fichier ordinaire plus petit."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} requires a body source compatible with its "
"API contract."
msgstr ""
"L'API Alibaba Cloud {operation} nécessite une source de corps compatible "
"avec son contrat d'API."

#: src/iac_code/tools/cloud/aliyun/public_errors.py
#, python-brace-format
msgid ""
"Alibaba Cloud API {operation} received multiple body sources. Provide "
"only one of body, body_file, or body parameters."
msgstr ""
"L'API Alibaba Cloud {operation} a reçu plusieurs sources de corps. "
"Fournissez uniquement body, body_file ou les paramètres body."

